<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-core/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-core-test</artifactId>
  <name>axiz :: core :: test</name>
  <description>Test fixtures for layer 1: mutable clock, recording publisher, metric assertions and an in-memory R2DBC fake</description>

  <properties>
    <axiz.module.name>pe.axiz.core.test</axiz.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-messaging</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-metrics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- FakeR2dbc: only for modules that test R2DBC stores -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-spi</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
