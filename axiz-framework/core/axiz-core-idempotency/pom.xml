<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-core/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-core-idempotency</artifactId>
  <name>axiz :: core :: idempotency</name>
  <description>API idempotency: key and fingerprint, stored responses, conflict detection</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <!-- M10: measured locally; floor of branch 161/204 and detected mutations 196/254. -->
    <axiz.coverage.branch>0.78</axiz.coverage.branch>
    <axiz.mutation.threshold>77</axiz.mutation.threshold>
    <axiz.module.name>pe.axiz.core.idempotency</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-lang</artifactId><version>${project.version}</version></dependency>

    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-id</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
