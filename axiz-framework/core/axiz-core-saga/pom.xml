<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-core/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-core-saga</artifactId>
  <name>axiz :: core :: saga</name>
  <description>Orchestrated sagas with retries, compensation and persistent, resumable state</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <!-- Umbrales mínimos del módulo: ramas 56/65 y mutaciones detectadas 76/98. -->
    <axiz.coverage.branch>0.86</axiz.coverage.branch>
    <axiz.mutation.threshold>81</axiz.mutation.threshold>
    <axiz.module.name>pe.axiz.core.saga</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-lock</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-crypto</artifactId><version>${project.version}</version></dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-resilience</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
