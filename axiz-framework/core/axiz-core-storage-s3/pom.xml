<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-core/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-core-storage-s3</artifactId>
  <name>axiz :: core :: storage-s3</name>
  <description>Amazon S3 object storage with SSE-KMS and presigned URLs</description>

  <properties>
    <axiz.module.name>pe.axiz.core.storage.s3</axiz.module.name>
  </properties>

  <dependencies>
    <!-- how the framework builds this adapter's AWS client (endpoint, region, observation): the
         auto-configuration uses it, so it travels with the adapter -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-observability-awssdk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
  </dependencies>
</project>
