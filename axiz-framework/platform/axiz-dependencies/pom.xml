<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-dependencies: versiones de terceros gobernadas por la plataforma (BOM, importado, no heredado).
  El orden importa: el primer BOM importado prevalece para un artefacto dado.
  Renovate mantiene estas versiones al día (ver renovate.json).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.axiz</groupId>
  <artifactId>axiz-dependencies</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>axiz :: dependencies</name>
  <description>Third-party dependency versions approved by the axiz platform</description>

  <distributionManagement>
    <repository>
      <id>github</id>
      <url>${axiz.packages.url}</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <url>${axiz.packages.url}</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <revision>2.0.0</revision>
    <axiz.packages.url>https://maven.pkg.github.com/edgarrth/java-framework-custom</axiz.packages.url>

    <!-- 4.1.2 gestiona Tomcat 11.0.27 (correcciones de 11.0.25 a 11.0.27, ver la página de seguridad de Tomcat 11) -->
    <spring-boot.version>4.1.2</spring-boot.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <spring-cloud-aws.version>4.2.0</spring-cloud-aws.version>
    <!-- GHSA-ccrj-gw8r-854m: análisis acotado de tracestate de W3C; se alinean API, SDK y exporters. -->
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <!-- como mínimo la versión que requiere aws-msk-iam-auth 2.3.8 (2.51.2): un único SDK para todos los clientes -->
    <awssdk.version>2.57.0</awssdk.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <shedlock.version>7.10.1</shedlock.version>
    <springdoc.version>3.1.1</springdoc.version>
    <aws-advanced-jdbc-wrapper.version>4.4.0</aws-advanced-jdbc-wrapper.version>
    <aws-msk-iam-auth.version>2.3.8</aws-msk-iam-auth.version>
    <datasource-micrometer.version>2.2.1</datasource-micrometer.version>
    <datasource-proxy.version>1.11.0</datasource-proxy.version>
    <openfeature.version>1.23.0</openfeature.version>
    <!-- Líneas de Jackson con las correcciones de GHSA-7hhh-6rmp-j9qf, GHSA-p6pp-m3f8-5c89, GHSA-cxp5-3px4-pw24,
         GHSA-wv8q-qhhj-9h54, GHSA-gx83-3vf8-gh7j, GHSA-q4xh-88c3-wmh7 y GHSA-wjgm-6hv5-3cvf, fijadas
         mediante sus BOM (importados antes que el de Spring Boot). Jackson 2 es solo una dependencia transitiva
         (AWS MSK IAM auth requiere 2.22.1 o posterior); axiz usa Jackson 3. -->
    <jackson2.version>2.22.3</jackson2.version>
    <jackson3.version>3.1.7</jackson3.version>
    <!-- transitiva (kafka-clients): 1.11.4 corrige GHSA-343h-94h5-c4wr, GHSA-4v53-57pg-c464,
         GHSA-6cx8-rjf8-pr8g, GHSA-gm45-99xc-r7wv, GHSA-mcr4-qmvw-px4g y GHSA-xx22-p4ch-683r -->
    <lz4-java.version>1.11.4</lz4-java.version>
    <!-- Compresión de Kafka: corrige GHSA-gwq9-9ffj-mvrv, GHSA-q233-g92q-qxp6 y GHSA-xqrx-qh46-34m7. -->
    <snappy-java.version>1.1.10.9</snappy-java.version>
    <!-- Herramientas (formatter / refaster): corrige GHSA-xxph-c9ww-hj94. -->
    <guava.version>33.7.2-jre</guava.version>
    <!-- Los jars de anotaciones tienen su propio ciclo de vida de dependencias: Guava 33.7.2 requiere 2.50.0.
         El plugin del compilador Error Prone se versiona por separado en el POM de build raíz. -->
    <errorprone-annotations.version>2.50.0</errorprone-annotations.version>
    <jetbrains-annotations.version>26.0.2-1</jetbrains-annotations.version>
    <!-- la versión que gestiona Spring Boot 4.1.2, declarada aquí solo para excluir una beta (ver más abajo) -->
    <lettuce.version>7.5.2.RELEASE</lettuce.version>
    <!-- transitiva (r2dbc-postgresql): 3.3 corrige GHSA-p9jg-fcr6-3mhf (degradación de channel binding) -->
    <scram.version>3.3</scram.version>
    <!-- anotaciones que llevan las clases del SDK de OpenFeature; la misma versión que SpotBugs en el build raíz -->
    <spotbugs.version>4.10.3</spotbugs.version>
    <archunit.version>1.5.1</archunit.version>
    <wiremock.version>3.13.2</wiremock.version>
    <!-- Plantillas de WireMock: CVE-2026-55760 está corregido en 4.5.2. -->
    <handlebars.version>4.5.2</handlebars.version>
    <!-- WireMock 3 usa los nombres de paquete originales de los helpers; solo el motor contiene el CVE. -->
    <handlebars-helpers.version>4.3.1</handlebars-helpers.version>
    <!-- Nashorn y JSON Smart convergen en una sola línea de ASM compatible con el JDK del proyecto. -->
    <asm.version>9.10.1</asm.version>
    <!-- Se alinean las rutas de dependencias de WireMock sin shading y de Testcontainers. -->
    <commons-io.version>2.20.0</commons-io.version>
    <!-- EE10 de WireMock y EE11 de Spring Boot se mantienen en la misma línea de runtime de Jetty. -->
    <jetty.version>12.1.14</jetty.version>
    <!-- 3.0.6 admite la línea Jackson 3.1 que gestiona Spring Boot. -->
    <json-schema-validator.version>3.0.6</json-schema-validator.version>
    <!-- API de transporte de Testcontainers 2.0.5 que usa el builder de la imagen de limpieza. -->
    <docker-java.version>3.7.1</docker-java.version>
    <blockhound.version>1.0.16.RELEASE</blockhound.version>
    <picocli.version>4.7.7</picocli.version>
    <jmustache.version>1.16</jmustache.version>
    <google-java-format.version>1.30.0</google-java-format.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <bouncycastle.version>1.85</bouncycastle.version>
    <jspecify.version>1.0.1</jspecify.version>
    <!-- pgJDBC expone estas anotaciones en su API nativa pero las declara solo de runtime. -->
    <checker-qual.version>3.55.1</checker-qual.version>
    <!-- primera versión de protobuf-java cuyo runtime completo no usa sun.misc.Unsafe (ver dependencyManagement) -->
    <protobuf.version>4.36.2</protobuf.version>
    <!-- la misma versión que Spring Security 7.1 (Spring Boot no la gestiona) -->
    <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.github.docker-java</groupId><artifactId>docker-java-api</artifactId><version>${docker-java.version}</version></dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
