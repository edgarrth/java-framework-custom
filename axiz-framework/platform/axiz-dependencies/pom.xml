        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <!-- Las métricas OTLP (micrometer-registry-otlp, que depende de opentelemetry-proto) incluyen protobuf-java.
           Hasta 4.35.x su runtime invoca los métodos de memoria de sun.misc.Unsafe marcados como terminalmente obsoletos
           (advertencia en Java 24+, con eliminación prevista); a partir de 4.36 (protobuf v36) el runtime completo
           que usa el código generado no los invoca. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
