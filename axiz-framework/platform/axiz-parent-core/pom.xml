<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-parent-core: parent of layer 1 (pure Java) modules and of teams' pure Java libraries.
  Adds: no Spring/Quarkus allowed, JSpecify, JUnit, code standards, mutation testing on core.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>axiz-parent-core</artifactId>
  <packaging>pom</packaging>
  <name>axiz :: parent :: core</name>
  <description>Parent for pure Java libraries (layer 1)</description>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>axiz-core-layer-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Layer 1 (core) is pure Java: Spring, Quarkus and compile-scope test libraries are not allowed</message>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.cloud:*</exclude>
                    <exclude>io.awspring.cloud:*</exclude>
                    <exclude>io.quarkus:*</exclude>
                    <exclude>org.junit.jupiter:*:*:*:compile</exclude>
                    <exclude>org.assertj:*:*:*:compile</exclude>
                    <exclude>org.mockito:*:*:*:compile</exclude>
                    <exclude>org.testcontainers:*:*:*:compile</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>pe.axiz</groupId>
            <artifactId>axiz-code-standards</artifactId>
            <version>${axiz.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>pe.axiz</groupId>
                <artifactId>axiz-code-standards</artifactId>
                <version>${axiz.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <targetClasses>
                <param>pe.axiz.*</param>
              </targetClasses>
              <targetTests>
                <param>pe.axiz.*</param>
              </targetTests>
            </configuration>
            <executions>
              <execution>
                <id>mutation</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
