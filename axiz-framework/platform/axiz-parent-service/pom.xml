<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-parent-service: parent de cada microservicio.
  Añade: BOM de axiz, JAR ejecutable, imagen de contenedor con Jib (JVM) o imagen nativa de GraalVM,
  generación de código contract-first, pruebas de integración, gates de cobertura y estándares de código.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>axiz-parent-service</artifactId>
  <packaging>pom</packaging>
  <name>axiz :: parent :: service</name>
  <description>Parent for axiz microservices</description>

  <properties>
    <axiz.version>${revision}</axiz.version>
    <!-- Imagen de contenedor -->
    <axiz.image.registry>ghcr.io/edgarrth/java-framework-custom</axiz.image.registry>
    <axiz.image.repository>${axiz.image.registry}/${project.artifactId}</axiz.image.repository>
    <!-- Imágenes base por tag y digest: Renovate fija y actualiza el digest (customManagers del
         preset de axiz); una imagen de release solo se construye desde una base fijada (service-ci) -->
    <!-- renovate: datasource=docker depName=azul/zulu-openjdk-alpine -->
    <axiz.image.base>azul/zulu-openjdk-alpine:25-jre@sha256:8eaca94dd76729a65ce7d693d8aa84c12f9ae656624ae3b118d6a8d411764cd8</axiz.image.base>
    <!-- BlockHound (servicios reactivos) redefine clases del JDK; se ignora donde la JVM no tiene el flag -->
    <!-- acceso nativo: ver Enable-Native-Access más abajo; las pruebas arrancan los mismos servidores Netty -->
    <axiz.test.argLine>-XX:+IgnoreUnrecognizedVMOptions -XX:+AllowRedefinitionToAddDeleteMethods --enable-native-access=ALL-UNNAMED -Djava.security.egd=file:/dev/./urandom</axiz.test.argLine>
    <!-- imágenes nativas: base glibc sin JVM, sin root -->
    <!-- renovate: datasource=docker depName=cgr.dev/chainguard/wolfi-base -->
    <axiz.image.native-base>cgr.dev/chainguard/wolfi-base@sha256:7135c6a5e9f29b2542aaefee63d474973312bfdea95555963aef0e648210e4d2</axiz.image.native-base>
    <jib-native-image-extension.version>0.1.0</jib-native-image-extension.version>
    <axiz.image.tag>${project.version}</axiz.image.tag>
    <!-- Contract-first: ubicación del contrato OpenAPI y paquetes generados -->
    <axiz.openapi.contract>${project.basedir}/src/main/openapi/openapi.yaml</axiz.openapi.contract>
    <axiz.openapi.api-package>${axiz.base-package}.api</axiz.openapi.api-package>
    <axiz.openapi.model-package>${axiz.base-package}.api.model</axiz.openapi.model-package>
    <axiz.base-package>pe.axiz.service</axiz.base-package>
    <openapi-generator.version>7.25.0</openapi-generator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>pe.axiz</groupId>
        <artifactId>axiz-bom</artifactId>
        <version>${axiz.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-test-spring-boot-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-archunit-rules</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths combine.children="append">
              <path>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Netty (WebFlux, Reactor Netty, Lettuce) carga su transporte nativo con System.loadLibrary,
           un método restringido desde JDK 24: sin acceso nativo la JVM advierte ("Restricted methods
           will be blocked in a future release") y una versión futura lo rechazará. El jar ejecutable
           lo concede al class path (atributo del manifiesto de JEP 472; repackage lo conserva) y la imagen
           hace lo mismo con el flag de la JVM, porque Jib arranca la clase main, no el jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>-Djava.security.egd=file:/dev/./urandom</jvmArguments>
        </configuration>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- las pruebas de integración se ejecutan después de package, cuando spring-boot:repackage ha reemplazado el jar por
           el ejecutable (clases bajo BOOT-INF/classes): Failsafe debe usar las clases
           compiladas, o no puede cargar los tipos propios del servicio (NoClassDefFoundError) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>axiz-service-layer-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Services declare starters, adapters in runtime and kits only for persistence code</message>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>pe.axiz:axiz-*-spring-boot-autoconfigure</exclude>
                    <exclude>pe.axiz:axiz-adapter-*:*:*:compile</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>axiz-service-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Services must not include test libraries in compile scope nor the OpenTelemetry Java agent</message>
                  <excludes>
                    <exclude>org.junit.jupiter:*:*:*:compile</exclude>
                    <exclude>org.mockito:*:*:*:compile</exclude>
                    <exclude>org.testcontainers:*:*:*:compile</exclude>
                    <exclude>io.opentelemetry.javaagent:*</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <from>
            <image>${axiz.image.base}</image>
          </from>
          <to>
            <image>${axiz.image.repository}:${axiz.image.tag}</image>
          </to>
          <container>
            <user>65532:65532</user>
            <jvmFlags>
              <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
              <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
              <jvmFlag>-Djava.security.egd=file:/dev/./urandom</jvmFlag>
              <jvmFlag>--enable-native-access=ALL-UNNAMED</jvmFlag>
            </jvmFlags>
            <ports>
              <port>8080</port>
            </ports>
            <labels>
              <org.opencontainers.image.source>${project.scm.url}</org.opencontainers.image.source>
              <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
            </labels>
            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Contract-first: genera las interfaces de la API y los modelos a partir de src/main/openapi/openapi.yaml -->
    <profile>
      <id>openapi</id>
      <activation>
        <file>
          <exists>${project.basedir}/src/main/openapi/openapi.yaml</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-api</id>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <inputSpec>${axiz.openapi.contract}</inputSpec>
                  <generatorName>spring</generatorName>
                  <apiPackage>${axiz.openapi.api-package}</apiPackage>
                  <modelPackage>${axiz.openapi.model-package}</modelPackage>
                  <!-- solo modelos: los controladores se generan una sola vez como esqueletos versionados  -->
                  <generateApis>false</generateApis>
                  <generateModels>true</generateModels>
                  <generateSupportingFiles>false</generateSupportingFiles>
                  <generateApiTests>false</generateApiTests>
                  <generateModelTests>false</generateModelTests>
                  <configOptions>
                    <interfaceOnly>true</interfaceOnly>
                    <useSpringBoot3>true</useSpringBoot3>
                    <useJakartaEe>true</useJakartaEe>
                    <useBeanValidation>true</useBeanValidation>
                    <performBeanValidation>true</performBeanValidation>
                    <useTags>true</useTags>
                    <skipDefaultInterface>true</skipDefaultInterface>
                    <openApiNullable>false</openApiNullable>
                    <!-- la inclusión y el manejo de nulos quedan a cargo del JsonMapper global (axiz-web) -->
                    <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
                    <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                    <dateLibrary>java8</dateLibrary>
                    <documentationProvider>none</documentationProvider>
                    <annotationLibrary>none</annotationLibrary>
                    <useResponseEntity>true</useResponseEntity>
                    <sourceFolder>src/main/java</sourceFolder>
                    <!-- marcador con retención de clase: JaCoCo deja los modelos generados fuera de los gates
                         de cobertura, que miden el código del servicio (ver pe.axiz.core.commons.Generated) -->
                    <additionalModelTypeAnnotations>@pe.axiz.core.commons.Generated("openapi-generator")</additionalModelTypeAnnotations>
                    <additionalEnumTypeAnnotations>@pe.axiz.core.commons.Generated("openapi-generator")</additionalEnumTypeAnnotations>
                  </configOptions>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- los modelos generados usan @Nullable de JSpecify, las anotaciones de null-safety de Spring 7
                 y de axiz, en lugar del obsoleto org.springframework.lang.Nullable -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>openapi-jspecify</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- Un contrato válido puede no generar clases de modelo (por ejemplo, solo respuestas 204). -->
                    <mkdir dir="${project.build.directory}/generated-sources/openapi/src/main/java" />
                    <replace dir="${project.build.directory}/generated-sources/openapi/src/main/java"
                             token="import org.springframework.lang.Nullable;"
                             value="import org.jspecify.annotations.Nullable;">
                      <include name="**/*.java" />
                    </replace>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Imagen nativa de GraalVM: ./mvnw -Pnative native:compile (o spring-boot:build-image) -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <goals>
                  <goal>process-aot</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <imageName>${project.artifactId}</imageName>
              <!-- Spring Boot reempaqueta el artefacto bajo BOOT-INF; se compilan las clases AOT. -->
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>--enable-sbom=cyclonedx</buildArg>
                <!-- Native Image captura el PRNG por defecto durante el análisis; un -D en tiempo de ejecución llega tarde. -->
                <buildArg>-Djava.security.egd=file:/dev/./urandom</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>add-reachability-metadata</id>
                <goals>
                  <goal>add-reachability-metadata</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- imagen nativa publicada por CI como <tag>-native: la extensión de Jib copia el binario
               (target/<artifactId>) y lo convierte en el entrypoint -->
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-native-image-extension-maven</artifactId>
                <version>${jib-native-image-extension.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <from>
                <image>${axiz.image.native-base}</image>
              </from>
              <to>
                <image>${axiz.image.repository}:${axiz.image.tag}-native</image>
              </to>
              <container>
                <user>65532:65532</user>
                <jvmFlags combine.self="override"/>
              </container>
              <pluginExtensions>
                <pluginExtension>
                  <implementation>com.google.cloud.tools.jib.maven.extension.nativeimage.JibNativeImageExtension</implementation>
                  <properties>
                    <imageName>${project.artifactId}</imageName>
                  </properties>
                </pluginExtension>
              </pluginExtensions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
              </sourceDirectories>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>pe.axiz</groupId>
                <artifactId>axiz-code-standards</artifactId>
                <version>${axiz.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>checkstyle</id>
                <phase>validate</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <configuration>
              <!-- OpenAPI es dueño de los modelos de transmisión mutables; todos los demás detectores siguen activos. -->
              <excludeFilterFile>axiz/spotbugs/generated-dtos.xml</excludeFilterFile>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>pe.axiz</groupId>
                <artifactId>axiz-code-standards</artifactId>
                <version>${axiz.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
