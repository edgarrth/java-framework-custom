<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-api</artifactId>
    <version>${revision}</version>
    <relativePath>../../../platform/axiz-parent-api/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-structure-layered-api</artifactId>
  <name>axiz :: structure :: layered :: api</name>
  <description>Layered style for simple CRUD services: controller, service and repository (contracts, plain Java)</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.module.name>pe.axiz.structure.layered</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-api</artifactId><version>${project.version}</version></dependency>

    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
        <executions><execution><id>check</id><configuration>
          <!-- Este enum no tiene comportamiento escrito por el usuario: sus únicas líneas ejecutables inicializan
               constantes. CrudLayersTest y CrudAcceptanceIT ejercitan todas las acciones en el
               consumidor. El comportamiento por defecto de QueryService sigue sujeto al gate completo;
               el enum se mantiene visible en los reportes y en la cobertura de integración agregada. -->
          <excludes><exclude>pe/axiz/structure/layered/CrudAction.class</exclude></excludes>
        </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
