  <artifactId>axiz-store-integration-tests</artifactId>
  <name>axiz :: quality :: store integration tests</name>
  <description>Store contracts run against real backends in containers: PostgreSQL (JDBC and R2DBC inbox), Valkey (idempotency) and LocalStack DynamoDB (idempotency and inbox)</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <!-- tests only: the jar holds just the manifest, by design (no "JAR will be empty" warning) -->
    <maven.jar.forceCreation>true</maven.jar.forceCreation>
    <axiz.module.name>pe.axiz.quality.stores</axiz.module.name>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Internal tests have no published binary API or 1.x jar. -->
    <axiz.api.skip>true</axiz.api.skip>
    <maven.install.skip>true</maven.install.skip>
    <!-- no production code here: the stores are mutation-tested in their own modules -->
    <skipPitest>true</skipPitest>
    <!-- CI sets it to true: without Docker the build fails instead of skipping these tests -->
    <axiz.it.requireDocker>false</axiz.it.requireDocker>
    <axiz.test.argLine>-XX:+IgnoreUnrecognizedVMOptions -XX:+AllowRedefinitionToAddDeleteMethods --enable-native-access=ALL-UNNAMED -Djava.security.egd=file:/dev/./urandom</axiz.test.argLine>
  </properties>

