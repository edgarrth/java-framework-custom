  <artifactId>axiz-coverage-report</artifactId>
  <!-- only aggregates the reports of the other modules: no classes of its own, so no jar
       (with jar packaging Maven warns "JAR will be empty") -->
  <packaging>pom</packaging>
  <name>axiz :: quality :: coverage report</name>
  <description>Aggregated JaCoCo report of the whole reactor (published to the CI run, not to Nexus)</description>

  <properties>
    <axiz.module.name>pe.axiz.quality.report</axiz.module.name>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <!-- overridden by -DskipTests: without tests there is nothing to aggregate -->
    <skipTests>false</skipTests>
  </properties>

  <!-- every module with production code, generated from the reactor and checked by
       .github/scripts/check-coverage-aggregate.py. The scope is provided: report-aggregate takes
       classes and sources only from compile, runtime and provided dependencies; a test
       dependency would add its execution data and nothing to measure it against. -->
