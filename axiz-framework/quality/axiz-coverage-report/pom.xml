  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>**/package-info.class</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- with the quality profile the modules run under the JaCoCo agent, so the aggregate must
         hold their classes and counters: an empty report fails the build instead of being
         published as if it measured something -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>aggregate-not-empty</id>
                <phase>verify</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <target>
                    <property name="aggregate" location="${project.build.directory}/site/jacoco-aggregate/jacoco.xml" />
                    <fail message="No aggregated JaCoCo report at ${aggregate}">
                      <condition>
                        <not>
                          <available file="${aggregate}" />
                        </not>
                      </condition>
                    </fail>
                    <fail message="The aggregated JaCoCo report has no classes: check the scope (provided) of the modules in this pom">
                      <condition>
                        <not>
                          <resourcecontains resource="${aggregate}" substring="&lt;package name=" />
                        </not>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
