<?xml version="1.0" encoding="UTF-8"?>
<!-- ArchUnit rules that services (and the framework) run in their tests. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-test</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-test/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-archunit-rules</artifactId>
  <name>axiz :: quality :: archunit rules</name>
  <description>Architecture rules for axiz services: general hygiene and one rule set per architectural style</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.module.name>pe.axiz.quality.archunit</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-messaging</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-tokenization</artifactId><version>${project.version}</version><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-carddata</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-tokenization-vault</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-saga</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-kit-jpa</artifactId><version>${project.version}</version><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-sensitive</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-commons</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-notification</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-audit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-http</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-crypto</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-secrets</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <!-- compile scope on purpose: this artifact is itself only used in test scope by services -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
    <!-- sample code for the reactive rules (blocking calls, global hooks) -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
<build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><executions><execution><id>axiz-core-layer-rules</id><configuration><rules><bannedDependencies><includes combine.children="append"><include>org.springframework:*:*:*:test</include><include>org.springframework.boot:*:*:*:test</include></includes></bannedDependencies></rules></configuration></execution></executions></plugin></plugins></build>
</project>
