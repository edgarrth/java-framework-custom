<!-- Excepción solo para servicios de la API de colecciones mutables de los DTO de transmisión generados por OpenAPI.
     No excluye clases escritas a mano, errores de constructor, SQL ni otras verificaciones de seguridad. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <Match>
    <Annotation name="pe.axiz.core.commons.Generated"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
