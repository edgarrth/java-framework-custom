<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Generated code is not ours to style -->
  <suppress files="[\\/]target[\\/]generated-(test-)?sources[\\/]" checks=".*"/>
  <!-- Tests: no Javadoc requirement, descriptive names allowed -->
  <suppress files="[\\/]src[\\/]test[\\/]" checks="MissingJavadocType|SummaryJavadoc|AbbreviationAsWordInName|MethodName|HideUtilityClassConstructor"/>
  <!-- CLI tools print to the console by design -->
  <suppress files="[\\/]axiz-cli[\\/]" id="noSystemOut"/>
  <!-- Build-time command line entry point run by CI (.github/scripts/samples.sh): its output is the console -->
  <suppress files="[\\/]pe[\\/]axiz[\\/]codegen[\\/]tools[\\/]SampleProjects\.java$" id="noSystemOut"/>
</suppressions>
