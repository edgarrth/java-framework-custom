<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>${revision}</version>
    <relativePath>../../../platform/axiz-parent-core/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-framework-cqrs-api</artifactId>
  <name>axiz :: framework :: cqrs :: api</name>
  <description>CQRS on top of hexagonal: commands, queries, buses with an ordered pipeline and projections (contracts, plain Java)</description>

  <properties>
    <axiz.module.name>pe.axiz.framework.cqrs</axiz.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-framework-hexagonal-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Publisher only, for reactive handlers; no Reactor or Spring types in the API -->
    <dependency>
      <groupId>org.reactivestreams</groupId>
      <artifactId>reactive-streams</artifactId>
    </dependency>
  </dependencies>
</project>
