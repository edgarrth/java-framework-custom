<?xml version="1.0" encoding="UTF-8"?>
<!-- Aggregator only (generated list of modules); it is never deployed. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>axiz-frameworks-aggregator</artifactId>
  <packaging>pom</packaging>
  <name>axiz :: frameworks</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <modules>
    <module>batch/axiz-framework-batch-api</module>
    <module>batch/axiz-framework-batch-spring-boot-starter</module>
    <module>bff/axiz-framework-bff-api</module>
    <module>bff/axiz-framework-bff-spring-boot-starter</module>
    <module>cqrs/axiz-framework-cqrs-api</module>
    <module>cqrs/axiz-framework-cqrs-spring-boot-starter</module>
    <module>eda/axiz-framework-eda-api</module>
    <module>eda/axiz-framework-eda-spring-boot-starter</module>
    <module>hexagonal/axiz-framework-hexagonal-api</module>
    <module>hexagonal/axiz-framework-hexagonal-spring-boot-starter</module>
    <module>layered/axiz-framework-layered-api</module>
    <module>layered/axiz-framework-layered-spring-boot-starter</module>
  </modules>
</project>
