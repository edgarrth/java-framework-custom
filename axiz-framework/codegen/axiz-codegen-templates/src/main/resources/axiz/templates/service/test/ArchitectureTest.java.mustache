package {{project.basePackage}};

import org.junit.jupiter.api.Test;
import pe.axiz.quality.archunit.Archetype;
import pe.axiz.quality.archunit.AxizArchitecture;
import pe.axiz.quality.archunit.CardDataScope;
import pe.axiz.quality.archunit.TokenizationScope;
{{#hasExtensions}}
import pe.axiz.quality.archunit.Extension;
{{/hasExtensions}}
import pe.axiz.quality.archunit.Stack;
import pe.axiz.quality.archunit.Structure;

/** Rules of the {{fw.id}} style plus the general axiz rules; breaking one fails the build. */
class ArchitectureTest {

  @Test
  void followsTheArchitecture() {
    architecture().verify();
  }

  static AxizArchitecture architecture() {
    return AxizArchitecture.of("{{project.basePackage}}")
        .archetype(Archetype.{{archetype.enum}})
        .stack(Stack.{{#stack.reactive}}REACTIVE{{/stack.reactive}}{{#stack.servlet}}SERVLET{{/stack.servlet}})
        .structure(Structure.{{fw.enum}})
        {{#extensions}}.extensions(Extension.{{enum}}){{/extensions}}
        .cardData(CardDataScope.{{cardDataScope}})
        .tokenization(TokenizationScope.{{tokenizationScope}});
  }
}
