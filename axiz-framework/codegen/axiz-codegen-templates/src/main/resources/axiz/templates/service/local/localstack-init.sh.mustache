#!/bin/bash
# Creates the AWS resources {{project.name}} uses locally (runs when LocalStack is ready).
# In real environments these resources are created by Terraform, never by the service.
set -euo pipefail
{{#caps.storages3}}
bucket=$(awslocal s3api list-buckets --query "Buckets[?Name=='local-bucket'].Name | [0]" --output text)
if [[ "$bucket" == None ]]; then
  awslocal s3 mb s3://local-bucket
fi
{{/caps.storages3}}
{{#caps.dynamodb}}
table() { # name, then "attribute:type:KEYTYPE" for each key attribute
  local name=$1 defs=() keys=(); shift
  for k in "$@"; do IFS=: read -r a t kt <<<"$k"
    defs+=("AttributeName=$a,AttributeType=$t"); keys+=("AttributeName=$a,KeyType=$kt"); done
  local description
  if description=$(awslocal dynamodb describe-table --table-name "local-$name" 2>&1); then
    return
  fi
  if [[ "$description" != *"(ResourceNotFoundException)"* ]]; then
    printf '%s\n' "$description" >&2
    return 1
  fi
  awslocal dynamodb create-table --table-name "local-$name" --billing-mode PAY_PER_REQUEST \
    --attribute-definitions "${defs[@]}" --key-schema "${keys[@]}" >/dev/null
}
# Service tables: add one line per repository, e.g. table items id:S:HASH
{{/caps.dynamodb}}
{{#caps.technicalinboxdynamodb}}
table axiz-inbox pk:S:HASH
{{/caps.technicalinboxdynamodb}}
{{#caps.idempotencydynamodb}}
table axiz-idempotency pk:S:HASH
{{/caps.idempotencydynamodb}}
{{#caps.lockdynamodb}}
table axiz-locks pk:S:HASH
{{/caps.lockdynamodb}}
{{#persistence.dynamodb}}
{{#caps.inbox}}
table axiz-inbox pk:S:HASH
{{/caps.inbox}}
{{#caps.sequence}}
table axiz-sequence pk:S:HASH
{{/caps.sequence}}
{{#caps.scheduling}}
table axiz-shedlock _id:S:HASH
{{/caps.scheduling}}
{{/persistence.dynamodb}}
{{#caps.messagingsqs}}
awslocal sqs create-queue --queue-name {{project.name}}-dlq
awslocal sqs create-queue --queue-name {{project.name}}
{{/caps.messagingsqs}}
{{#caps.messagingsns}}
awslocal sns create-topic --name {{project.name}}-events
{{/caps.messagingsns}}
{{#auditResources.queue}}
awslocal sqs create-queue --queue-name {{project.name}}-audit
{{/auditResources.queue}}
{{#auditResources.topic}}
awslocal sns create-topic --name {{project.name}}-audit
{{/auditResources.topic}}
{{#caps.crypto}}
if key=$(awslocal kms describe-key --key-id alias/local --query KeyMetadata.KeyId --output text 2>&1); then
  : # The existing alias already owns its local key.
else
  if [[ "$key" != *"(NotFoundException)"* ]]; then
    printf '%s\n' "$key" >&2
    exit 1
  fi
  key=$(awslocal kms create-key --query KeyMetadata.KeyId --output text)
  awslocal kms create-alias --alias-name alias/local --target-key-id "$key"
fi
{{/caps.crypto}}
