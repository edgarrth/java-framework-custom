package {{platform.springPackage}};

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.boot.autoconfigure.AutoConfigurations;
import org.springframework.boot.test.context.runner.ApplicationContextRunner;
import {{project.basePackage}}.{{platform.mainClass}};

class {{platform.autoConfigurationClass}}Test {

  private final ApplicationContextRunner runner =
      new ApplicationContextRunner()
          .withConfiguration(AutoConfigurations.of({{platform.autoConfigurationClass}}.class));

  @Test
  void createsTheBeanFromProperties() {
    runner
        .withPropertyValues("{{platform.prefix}}.name=demo")
        .run(ctx -> assertThat(ctx.getBean({{platform.mainClass}}.class).name()).isEqualTo("demo"));
  }

  @Test
  void backsOffWhenDisabled() {
    runner
        .withPropertyValues("{{platform.prefix}}.enabled=false")
        .run(ctx -> assertThat(ctx).doesNotHaveBean({{platform.mainClass}}.class));
  }

  @Test
  void backsOffWhenTheApplicationDefinesItsOwn() {
    runner
        .withBean({{platform.mainClass}}.class, () -> new {{platform.mainClass}}("own"))
        .run(ctx -> assertThat(ctx.getBean({{platform.mainClass}}.class).name()).isEqualTo("own"));
  }
}
