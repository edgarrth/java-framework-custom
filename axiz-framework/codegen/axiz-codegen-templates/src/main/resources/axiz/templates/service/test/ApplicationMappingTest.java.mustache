  void requestExampleSurvivesApplicationMapping() throws Exception {
    var mapper = JsonMapper.builder().build();
    try (var input = getClass().getResourceAsStream("/contract-examples/{{item.operationId}}.json")) {
      var transport = mapper.readValue(Objects.requireNonNull(input),
          {{api.modelPackage}}.{{item.requestType}}.class);
      var application = mapper.convertValue(transport,
          {{project.basePackage}}.application.model.{{item.requestType}}.class);
      var restored = mapper.convertValue(application,
          {{api.modelPackage}}.{{item.requestType}}.class);
      assertEquals(mapper.valueToTree(transport), mapper.valueToTree(restored));
    }
  }
}
