package {{project.basePackage}};

import java.util.Objects;

/**
 * Punto de entrada de la biblioteca {{project.name}}. Este ejemplo se reemplaza por la API de la
 * biblioteca.
 *
 * @param name un nombre no vacío
 */
public record {{platform.mainClass}}(String name) {

  public {{platform.mainClass}} {
    Objects.requireNonNull(name, "name");
    if (name.isBlank()) {
      throw new IllegalArgumentException("name must not be blank");
    }
  }

  /** Saludo para el nombre. */
  public String greeting() {
    return "Hello " + name;
  }
}
