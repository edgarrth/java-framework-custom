  @Test
  void importsTheFileAndIgnoresDuplicateReferences(
      @Autowired Job {{project.camelName}}Job, @Autowired JobOperator jobs,
      @Autowired ObjectStorage storage, @Autowired JdbcTemplate jdbc,
      @Autowired LocalStackContainer localstack,
      @org.springframework.beans.factory.annotation.Value("${axiz.storage.bucket}") String bucket) throws Exception {
    assertThat({{project.camelName}}Job.getName()).isEqualTo("{{project.name}}");
    assertThat(localstack.execInContainer("awslocal", "s3", "mb", "s3://" + bucket)
        .getExitCode()).isZero();
    byte[] csv = "reference;value\n first ; 10 \n;ignored\nfirst;duplicate\nsecond;20\n"
        .getBytes(StandardCharsets.UTF_8);
    storage.put("in/input.csv", new ByteArrayInputStream(csv), ObjectMetadata.of("text/csv", csv.length));
    for (int attempt = 0; attempt < 2; attempt++) {
      var execution = jobs.start({{project.camelName}}Job,
          new JobParametersBuilder().addString("run", UUID.randomUUID().toString()).toJobParameters());
      assertThat(execution.getStatus()).isEqualTo(BatchStatus.COMPLETED);
      assertThat(execution.getStepExecutions()).singleElement().satisfies(step -> {
        assertThat(step.getReadCount()).isEqualTo(4);
        assertThat(step.getFilterCount()).isEqualTo(1);
      });
      assertThat(jdbc.queryForList("SELECT reference FROM input_line ORDER BY reference", String.class))
          .containsExactly("first", "second");
      assertThat(jdbc.queryForObject("SELECT line_value FROM input_line WHERE reference = 'first'", String.class))
          .isEqualTo("10");
    }
  }
