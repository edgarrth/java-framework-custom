  @Autowired AxizJwtConverter jwtConverter;

  private AxizAuthentication caller(String... authorities) {
    String scopes = Arrays.stream(authorities).map(authority -> authority.substring("SCOPE_".length()))
        .collect(Collectors.joining(" "));
    return jwtConverter.convert(Jwt.withTokenValue("synthetic-test-token").header("alg", "RS256")
        .subject("test-user").claim("client_id", "test-client").issuer("https://issuer.test")
        .claim("scope", scopes).build());
  }
