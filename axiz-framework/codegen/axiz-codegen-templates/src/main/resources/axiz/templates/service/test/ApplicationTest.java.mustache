{{#auditResources.required}}
{{#stack.reactive}}
  @Test
  void autoConfiguresTheNativeAuditTransport(@Autowired ApplicationContext context,
      @Autowired MeterRegistry metrics) {
{{#auditResources.outboxSqs}}
    var sqs = context.getBean("axizMessagingSqsAsyncClient", SqsAsyncClient.class);
    assertThat(sqs.serviceClientConfiguration().overrideConfiguration().apiCallTimeout())
        .contains(context.getBean(AxizMessagingAwsProperties.class).apiCallTimeout());
    assertThat(context.containsBean("axizMessagingSqsAsyncResources")).isTrue();
    assertThat(metrics.find("axiz.transport.pending").tag("transport", "axizMessagingSqsAsyncResources").gauge()).isNotNull();
{{/auditResources.outboxSqs}}
{{#auditResources.outboxSns}}
    var sns = context.getBean("axizMessagingSnsAsyncClient", SnsAsyncClient.class);
    assertThat(sns.serviceClientConfiguration().overrideConfiguration().apiCallTimeout())
        .contains(context.getBean(AxizMessagingAwsProperties.class).apiCallTimeout());
    assertThat(context.containsBean("axizMessagingSnsAsyncResources")).isTrue();
    assertThat(metrics.find("axiz.transport.pending").tag("transport", "axizMessagingSnsAsyncResources").gauge()).isNotNull();
{{/auditResources.outboxSns}}
{{#auditResources.sqsSink}}
    assertThat(context.getBeansOfType(SqsAsyncClient.class)).hasSize(1);
{{^caps.outbox}}
    assertThat(context.containsBean("axizAuditAsyncAwsResources")).isTrue();
    assertThat(metrics.find("axiz.transport.pending").tag("transport", "axizAuditAsyncAwsResources").gauge()).isNotNull();
{{/caps.outbox}}
{{/auditResources.sqsSink}}
    assertThat(context.containsBean("auditTestAsyncResources")).isFalse();
  }
{{/stack.reactive}}
{{/auditResources.required}}

