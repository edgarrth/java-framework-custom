package {{project.basePackage}};

import java.time.Duration;
import org.springframework.boot.test.util.TestPropertyValues;
import org.springframework.context.ApplicationContextInitializer;
import org.springframework.context.support.GenericApplicationContext;
import pe.axiz.spring.test.AxizContainers;
import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
{{#auditResources.queue}}
import software.amazon.awssdk.services.sqs.SqsClient;
{{/auditResources.queue}}
{{#auditResources.topic}}
import software.amazon.awssdk.services.sns.SnsClient;
{{/auditResources.topic}}

/** Creates only test resources, before Spring selects the production AWS auto-configurations. */
class AuditTestConfiguration implements ApplicationContextInitializer<GenericApplicationContext> {
  @Override
  public void initialize(GenericApplicationContext context) {
    var localstack = AxizContainers.localstack();
    try {
      localstack.start();
      var credentials = StaticCredentialsProvider.create(
          AwsBasicCredentials.create(localstack.getAccessKey(), localstack.getSecretKey()));
{{#auditResources.queue}}
      String queueUrl;
      try (var sqs = SqsClient.builder()
          .endpointOverride(localstack.getEndpoint())
          .region(Region.of(localstack.getRegion()))
          .credentialsProvider(credentials)
          .overrideConfiguration(config -> config.apiCallTimeout(Duration.ofSeconds(10)))
          .build()) {
        queueUrl = sqs.createQueue(request -> request.queueName("{{project.name}}-audit")).queueUrl();
      }
{{/auditResources.queue}}
{{#auditResources.topic}}
      String topicArn;
      try (var sns = SnsClient.builder()
          .endpointOverride(localstack.getEndpoint())
          .region(Region.of(localstack.getRegion()))
          .credentialsProvider(credentials)
          .overrideConfiguration(config -> config.apiCallTimeout(Duration.ofSeconds(10)))
          .build()) {
        topicArn = sns.createTopic(request -> request.name("{{project.name}}-audit")).topicArn();
      }
{{/auditResources.topic}}
      TestPropertyValues.of(
          "axiz.aws.endpoint=" + localstack.getEndpoint(),
          "axiz.aws.region=" + localstack.getRegion(),
          "spring.cloud.aws.endpoint=" + localstack.getEndpoint(),
          "spring.cloud.aws.region.static=" + localstack.getRegion(),
          "axiz.config.environment=test",
          "axiz.transport.allow-plain-http=true"
{{#auditResources.sqsSink}}
          , "axiz.audit.sqs.queue-url=" + queueUrl
{{/auditResources.sqsSink}}
{{#auditResources.outboxSqs}}
          , "axiz.messaging.destinations.audit=" + queueUrl
{{/auditResources.outboxSqs}}
{{#auditResources.outboxSns}}
          , "axiz.messaging.destinations.audit=" + topicArn
{{/auditResources.outboxSns}}
      ).applyTo(context);
      // Register before production client beans are selected; identity is local to this context.
      context.registerBean("auditTestAwsCredentialsProvider", AwsCredentialsProvider.class, () -> credentials);
      context.getBeanFactory().registerSingleton("auditTestLocalStack", localstack);
      context.getDefaultListableBeanFactory().registerDisposableBean("auditTestLocalStack", localstack::stop);
    } catch (RuntimeException | Error failure) {
      try {
        localstack.stop();
      } catch (RuntimeException | Error cleanupFailure) {
        failure.addSuppressed(cleanupFailure);
      }
      throw failure;
    }
  }

}
