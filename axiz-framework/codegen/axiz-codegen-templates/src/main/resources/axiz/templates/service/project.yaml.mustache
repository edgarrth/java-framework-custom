# Manifiesto del proyecto axiz: lo lee la CLI axiz (generate, add, contract sync, upgrade, doctor).
# Se versiona en el repositorio; la CLI lo actualiza cuando cambia el proyecto.
schema: 2
kind: service
name: {{project.name}}
groupId: {{project.groupId}}
basePackage: {{project.basePackage}}
archetype: {{archetype.name}}
structure: {{fw.id}}
extensions: [{{#extensions}}{{id}}{{/extensions}}]
stack: {{stack.id}}
persistence: {{persistence.id}}
axizVersion: {{axizVersion}}
contract:
  openapi: {{#api.present}}src/main/openapi/openapi.yaml{{/api.present}}{{^api.present}}null{{/api.present}}
  asyncapi: {{#api.hasAsyncapi}}src/main/asyncapi/asyncapi.yaml{{/api.hasAsyncapi}}{{^api.hasAsyncapi}}null{{/api.hasAsyncapi}}
capabilities:
{{#capabilities}}
  - {{name}}
{{/capabilities}}
operations:
{{#operations}}
  - {{operationId}}
{{/operations}}
{{^operations}}
  []
{{/operations}}
