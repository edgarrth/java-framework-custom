{{=<% %>=}}
# Pipeline de la librería con el workflow reutilizable de Axiz: verificación en cada cambio y, con
# un tag v*, publicación en GitHub Packages con procedencia atestiguada de cada jar.
name: ci
on:
  pull_request:
  push:
    branches: [main]
    tags: ["v*"]
  workflow_dispatch:
permissions: {}
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  build:
    uses: edgarrth/java-framework-custom/.github/workflows/lib-build.yaml@axiz-workflows-v2.0.0 # x-release-please-version
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    with:
      publish: ${{ startsWith(github.ref, 'refs/tags/v') }}
