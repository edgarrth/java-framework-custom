{{=<% %>=}}
# Pipeline of <% project.name %> (shared axiz workflows, pinned to an immutable release; Renovate pins its commit):
#   pull request  pr checks (title, secrets, dependencies, Semgrep, Trivy, actionlint) + build
#   develop       build and publish the SNAPSHOT to Nexus
#   tag v*        build and publish the release (tags come from release.yaml)
name: ci

on:
  pull_request:
  push:
    branches: [main, develop]
    tags: ["v*"]

permissions:
  contents: read
  pull-requests: read
  security-events: write

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  pr:
    if: github.event_name == 'pull_request'
    uses: axiz/axiz-workflows/.github/workflows/pr.yaml@v1.0.0
    secrets: inherit

  build:
    uses: axiz/axiz-workflows/.github/workflows/lib-publish.yaml@v1.0.0
    with:
      publish: ${{ github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/tags/v') }}
    secrets: inherit
