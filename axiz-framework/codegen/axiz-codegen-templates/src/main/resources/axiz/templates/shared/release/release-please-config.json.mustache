{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "draft": {{#archetype.library}}true{{/archetype.library}}{{^archetype.library}}{{#archetype.starter}}true{{/archetype.starter}}{{^archetype.starter}}false{{/archetype.starter}}{{/archetype.library}},
  "force-tag-creation": true,
  "extra-files": [
    {"type": "xml", "path": "pom.xml", "xpath": "/*[local-name()='project']/*[local-name()='version']"}{{#archetype.starter}},
    {"type": "xml", "path": "{{platform.coreArtifact}}/pom.xml", "xpath": "/*[local-name()='project']/*[local-name()='version']"},
    {"type": "xml", "path": "{{platform.capabilityArtifact}}-spring-boot-autoconfigure/pom.xml", "xpath": "/*[local-name()='project']/*[local-name()='version']"},
    {"type": "xml", "path": "{{platform.capabilityArtifact}}-spring-boot-starter/pom.xml", "xpath": "/*[local-name()='project']/*[local-name()='version']"}{{/archetype.starter}}
  ],
  "initial-version": "0.1.0",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Fixes"},
    {"type": "perf", "section": "Performance"},
    {"type": "refactor", "section": "Refactoring"},
    {"type": "docs", "section": "Documentation"},
    {"type": "build", "section": "Build", "hidden": true},
    {"type": "ci", "section": "CI", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "chore", "section": "Chores", "hidden": true}
  ],
  "packages": {
    ".": {}
  }
}
