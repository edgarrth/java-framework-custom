# {{project.name}} in {{item.name}}
environment: {{item.name}}

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::ACCOUNT_ID:role/{{project.name}}-{{item.name}}

resources:
  requests:
    cpu: {{item.cpu}}
    memory: {{item.memory}}
  limits:
    memory: {{item.memory}}
{{#archetype.deployment}}

autoscaling:
  enabled: true
  minReplicas: {{item.minReplicas}}
  maxReplicas: {{item.maxReplicas}}
  targetCPUUtilizationPercentage: 70
{{#item.prod}}
topologySpread:
  whenUnsatisfiable: DoNotSchedule   # replicas in different zones, always
{{/item.prod}}
{{/archetype.deployment}}

networkPolicy:
  egress:
    # destinations outside the cluster this service reaches in {{item.name}} (VPC endpoints of
    # the AWS services it uses, databases, brokers, partners), with their ports
    cidrs: []

externalSecret:
  remotePrefix: {{item.name}}/{{project.name}}

config:
  axiz.config.environment: {{item.name}}
  management.tracing.sampling.probability: "{{item.samplingProbability}}"
{{#caps.audit}}
  # the audit chain is sealed with a keyed HMAC outside local/test/ci (secret audit-hmac-key)
  axiz.audit.integrity.mode: HMAC
  axiz.audit.integrity.hmac-secret: audit-hmac-key
  axiz.audit.integrity.hmac-key-id: v1
{{/caps.audit}}
  # Keys this service needs in {{item.name}} (set their values, then remove the comment):
{{#config.configMapKeys}}
  # {{.}}:
{{/config.configMapKeys}}

errors: []
