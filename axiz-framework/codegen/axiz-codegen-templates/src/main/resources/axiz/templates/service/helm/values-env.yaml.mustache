# {{project.name}} en {{item.name}}
environment: {{item.name}}

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::ACCOUNT_ID:role/{{project.name}}-{{item.name}}

resources:
  requests:
    cpu: {{item.cpu}}
    memory: {{item.memory}}
  limits:
    memory: {{item.memory}}
{{#archetype.deployment}}

autoscaling:
  enabled: true
  minReplicas: {{item.minReplicas}}
  maxReplicas: {{item.maxReplicas}}
  targetCPUUtilizationPercentage: 70
{{#item.prod}}
topologySpread:
  whenUnsatisfiable: DoNotSchedule   # réplicas en zonas distintas, siempre
{{/item.prod}}
{{/archetype.deployment}}

networkPolicy:
  egress:
    # destinos fuera del clúster a los que este servicio llega en {{item.name}} (VPC endpoints de
    # los servicios de AWS que usa, bases de datos, brokers, socios), con sus puertos
    cidrs: []

externalSecret:
  remotePrefix: {{item.name}}/{{project.name}}

config:
  axiz.config.environment: {{item.name}}
  management.tracing.sampling.probability: "{{item.samplingProbability}}"
{{#caps.audit}}
  # la cadena de auditoría se sella con un HMAC con clave fuera de local/test/ci (secreto audit-hmac-key)
  axiz.audit.integrity.mode: HMAC
  axiz.audit.integrity.hmac-secret: audit-hmac-key
  axiz.audit.integrity.hmac-key-id: v1
{{/caps.audit}}
  # Claves que este servicio necesita en {{item.name}} (se definen sus valores y luego se elimina el comentario):
{{#config.configMapKeys}}
  # {{.}}:
{{/config.configMapKeys}}

errors: []
