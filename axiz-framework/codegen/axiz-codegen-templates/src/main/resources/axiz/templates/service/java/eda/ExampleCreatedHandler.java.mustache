package {{project.basePackage}}.handler;

{{#stack.reactive}}
import org.reactivestreams.Publisher;
{{/stack.reactive}}
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import pe.axiz.core.messaging.EventEnvelope;
import pe.axiz.core.messaging.HandlesEvent;
{{#stack.reactive}}
import pe.axiz.spring.messaging.ReactiveTypedEventHandler;
import reactor.core.publisher.Mono;
{{/stack.reactive}}
{{^stack.reactive}}
import pe.axiz.core.messaging.TypedEventHandler;
{{/stack.reactive}}
import {{project.basePackage}}.event.ExampleCreated;

/**
 * Reacciona a los eventos {@code example.created}. La entrega es al menos una vez: el handler debe
 * ser idempotente (la capacidad inbox deduplica por id de evento); una falla se reintenta con
 * backoff y se envía a dead-letter tras los intentos configurados.
{{#stack.reactive}}
 * No bloqueante: el publisher devuelto se ejecuta en una transacción reactiva{{#persistence.r2dbc}}
 * (las escrituras R2DBC y los eventos del outbox se confirman juntos){{/persistence.r2dbc}} y el
 * consumidor lo espera, con el límite de {@code axiz.messaging.consumer.handler-timeout}.
{{/stack.reactive}}
 */
@Component
@HandlesEvent("{{project.groupId}}.example.created.v1")
{{#stack.reactive}}
public class ExampleCreatedHandler extends ReactiveTypedEventHandler<ExampleCreated> {

  private static final Logger LOG = LoggerFactory.getLogger(ExampleCreatedHandler.class);

  @Override
  protected Publisher<Void> on(ExampleCreated payload, EventEnvelope envelope) {
    return Mono.fromRunnable(
        () -> LOG.info("example created: exampleId={} eventId={}", payload.id(), envelope.id()));
  }
}
{{/stack.reactive}}
{{^stack.reactive}}
public class ExampleCreatedHandler extends TypedEventHandler<ExampleCreated> {

  private static final Logger LOG = LoggerFactory.getLogger(ExampleCreatedHandler.class);

  @Override
  protected void on(ExampleCreated payload, EventEnvelope envelope) {
    LOG.info("example created: exampleId={} eventId={}", payload.id(), envelope.id());
  }
}
{{/stack.reactive}}
