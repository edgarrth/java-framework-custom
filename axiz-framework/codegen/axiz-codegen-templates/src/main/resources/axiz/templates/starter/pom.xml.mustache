<?xml version="1.0" encoding="UTF-8"?>
<!-- {{project.title}}: agregador de la biblioteca, su autoconfiguración y su starter. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent</artifactId>
    <version>{{axizVersion}}</version>
    <relativePath/>
  </parent>

  <groupId>{{project.groupId}}</groupId>
  <artifactId>{{project.artifactId}}-aggregator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>{{project.title}} (aggregator)</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <modules>
    <module>{{platform.coreArtifact}}</module>
    <module>{{platform.capabilityArtifact}}-spring-boot-autoconfigure</module>
    <module>{{platform.capabilityArtifact}}-spring-boot-starter</module>
  </modules>
</project>
