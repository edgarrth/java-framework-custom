# Defaults of the {{project.name}} chart; values-<env>.yaml override them per environment.
nameOverride: ""
environment: ""

image:
  repository: ghcr.io/edgarrth/java-framework-custom/{{project.name}}
  tag: ""          # set by the deployment (GitOps): the commit of the image
  digest: ""       # set by the deployment (GitOps): pins the signed image
  pullPolicy: IfNotPresent
imagePullSecrets: []

serviceAccount:
  create: true
  name: ""
  annotations: {}  # eks.amazonaws.com/role-arn per environment (IRSA)
  # the pods never call the Kubernetes API (configuration is mounted as files); the AWS identity
  # (IRSA or EKS Pod Identity) uses its own projected token
  automountToken: false

# shared configuration of the namespace (optional ConfigMap, mounted before the service's own)
sharedConfigMap: ""

javaOpts: "-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"
env: []
# Select imports before application.yaml and mounted ConfigMaps are loaded.
configBootstrap:
  parameterStore:
    enabled: false
    application: ""
    prefix: /axiz

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    memory: 512Mi

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65532
  runAsGroup: 65532
  fsGroup: 65532
  seccompProfile:
    type: RuntimeDefault
securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: ["ALL"]
{{#archetype.deployment}}

replicaCount: 2
terminationGracePeriodSeconds: 30
service:
  port: 80
probes:
  startupFailureThreshold: 30
autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 4
  targetCPUUtilizationPercentage: 70
pdb:
  enabled: true
  maxUnavailable: 1
topologySpread:
  whenUnsatisfiable: ScheduleAnyway   # DoNotSchedule in prod (values-prod.yaml)
{{/archetype.deployment}}
{{#archetype.cronjob}}

cronjob:
  schedule: "0 2 * * *"
  timeZone: America/Lima
  suspend: false
  startingDeadlineSeconds: 600
  backoffLimit: 1
  activeDeadlineSeconds: 7200
{{/archetype.cronjob}}

networkPolicy:
  enabled: true
  ingressNamespaces: []   # namespaces allowed to call the service (ingress, gateway, callers)
  # Outbound traffic is denied except DNS and what is listed here
  egress:
    sameNamespace: true   # sibling services of the namespace
    namespaces: []        # other namespaces this service calls
    cidrs: []             # e.g. {cidr: 10.20.0.0/16, ports: [443, 5432]}: VPC endpoints, Aurora,
                          # ElastiCache, MSK, partners. Fill per environment (values-<env>.yaml)

# ConfigMap {{project.name}} (application.yaml): environment values, flat Spring Boot keys
config: {}

# ConfigMap {{project.name}}-errors: error catalog (code, category, title, detail keys...)
errors: []

# Secret files mounted in /var/run/secrets/axiz (one per key). enabled: the External Secrets
# Operator creates the Secret <fullname>-secrets from AWS Secrets Manager; disabled: the Secret is
# created by other means (kind and local clusters, see the demo kind/ scripts).
externalSecret:
  enabled: true
  storeName: aws-secrets-manager
  refreshInterval: 1h
  remotePrefix: dev/{{project.name}}
  keys:
{{#config.secrets}}
    - {{key}}
{{/config.secrets}}
{{^config.hasSecrets}}
    []
{{/config.hasSecrets}}

# Requires Prometheus Operator and an existing scrape configuration for this service.
monitoring:
  prometheusRules:
    enabled: false
    labels: {} # labels selected by the cluster's Prometheus ruleSelector
    metricSelector: "" # defaults to namespace + service; adapt to your scrape target labels
    audit: {{#caps.audit}}true{{/caps.audit}}{{^caps.audit}}false{{/caps.audit}}
    outbox: {{#caps.outbox}}true{{/caps.outbox}}{{^caps.outbox}}false{{/caps.outbox}}
