# Valores por defecto del chart {{project.name}}; values-<env>.yaml los sobrescribe por entorno.
nameOverride: ""
environment: ""

image:
  repository: ghcr.io/edgarrth/java-framework-custom/{{project.name}}
  tag: ""          # lo define el despliegue (GitOps): el commit de la imagen
  digest: ""       # lo define el despliegue (GitOps): fija la imagen firmada
  pullPolicy: IfNotPresent
imagePullSecrets: []

serviceAccount:
  create: true
  name: ""
  annotations: {}  # eks.amazonaws.com/role-arn por entorno (IRSA)
  # los pods nunca invocan la API de Kubernetes (la configuración se monta como archivos); la identidad de AWS
  # (IRSA o EKS Pod Identity) usa su propio token proyectado
  automountToken: false

# configuración compartida del namespace (ConfigMap opcional, montado antes que el propio del servicio)
sharedConfigMap: ""

javaOpts: "-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"
env: []
# Las importaciones se seleccionan antes de cargar application.yaml y los ConfigMaps montados.
configBootstrap:
  parameterStore:
    enabled: false
    application: ""
    prefix: /axiz

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    memory: 512Mi

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65532
  runAsGroup: 65532
  fsGroup: 65532
  seccompProfile:
    type: RuntimeDefault
securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: ["ALL"]
terminationGracePeriodSeconds: 90
{{#archetype.deployment}}

replicaCount: 2
service:
  port: 80
probes:
  startupFailureThreshold: 30
autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 4
  targetCPUUtilizationPercentage: 70
pdb:
  enabled: true
  maxUnavailable: 1
topologySpread:
  whenUnsatisfiable: ScheduleAnyway   # DoNotSchedule en prod (values-prod.yaml)
{{/archetype.deployment}}
{{#archetype.cronjob}}

cronjob:
  schedule: "0 2 * * *"
  timeZone: America/Lima
  suspend: false
  startingDeadlineSeconds: 600
  backoffLimit: 1
  activeDeadlineSeconds: 7200
{{/archetype.cronjob}}

networkPolicy:
  enabled: true
  ingressNamespaces: []   # namespaces autorizados a invocar el servicio (ingress, gateway, invocadores)
  # El tráfico saliente se deniega salvo DNS y lo que se lista aquí
  egress:
    sameNamespace: true   # servicios hermanos del namespace
    namespaces: []        # otros namespaces que invoca este servicio
    cidrs: []             # e.g. {cidr: 10.20.0.0/16, ports: [443, 5432]}: VPC endpoints, Aurora,
                          # ElastiCache, MSK, socios. Se completa por entorno (values-<env>.yaml)

# ConfigMap {{project.name}} (application.yaml): valores del entorno, claves planas de Spring Boot
config: {}

# ConfigMap {{project.name}}-errors: catálogo de errores (código, categoría, título, claves de detalle...)
errors: []

# Archivos de secretos montados en /var/run/secrets/axiz (uno por clave). enabled: el External Secrets
# Operator crea el Secret <fullname>-secrets desde AWS Secrets Manager; disabled: el Secret se
# crea por otros medios (kind y clústeres locales, ver los scripts kind/ de la demo).
externalSecret:
  enabled: true
  storeName: aws-secrets-manager
  refreshInterval: 1h
  remotePrefix: dev/{{project.name}}
  keys:
{{#config.secrets}}
    - {{key}}
{{/config.secrets}}
{{^config.hasSecrets}}
    []
{{/config.hasSecrets}}

# Requiere Prometheus Operator y una configuración de scrape existente para este servicio.
monitoring:
  prometheusRules:
    enabled: false
    labels: {} # etiquetas que selecciona el ruleSelector de Prometheus del clúster
    metricSelector: "" # por defecto namespace + service; se adapta a las etiquetas del target de scrape
    audit: {{#caps.audit}}true{{/caps.audit}}{{^caps.audit}}false{{/caps.audit}}
    outbox: {{#caps.outbox}}true{{/caps.outbox}}{{^caps.outbox}}false{{/caps.outbox}}
