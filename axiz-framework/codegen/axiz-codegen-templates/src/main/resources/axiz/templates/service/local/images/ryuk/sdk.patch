+package main
+
+import (
+	"context"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/image"
+	"github.com/moby/moby/api/types/network"
+	"github.com/moby/moby/api/types/volume"
+	"github.com/moby/moby/client"
+)
+
+// Keep Ryuk's resource-cleanup interface while using the maintained split Docker SDK.
+// No archived github.com/docker/docker implementation is linked into the executable.
+type dockerCompatibility struct{ *client.Client }
+
+func newDockerClient() (*dockerCompatibility, error) {
+	c, err := client.New(client.FromEnv)
+	if err != nil {
+		return nil, err
+	}
+	return &dockerCompatibility{c}, nil
+}
+func (c *dockerCompatibility) ContainerList(ctx context.Context, o client.ContainerListOptions) ([]container.Summary, error) {
+	r, e := c.Client.ContainerList(ctx, o)
+	return r.Items, e
+}
+func (c *dockerCompatibility) ContainerRemove(ctx context.Context, id string, o client.ContainerRemoveOptions) error {
+	_, e := c.Client.ContainerRemove(ctx, id, o)
+	return e
+}
+func (c *dockerCompatibility) ImageList(ctx context.Context, o client.ImageListOptions) ([]image.Summary, error) {
+	r, e := c.Client.ImageList(ctx, o)
+	return r.Items, e
+}
+func (c *dockerCompatibility) ImageRemove(ctx context.Context, id string, o client.ImageRemoveOptions) ([]image.DeleteResponse, error) {
+	r, e := c.Client.ImageRemove(ctx, id, o)
+	return r.Items, e
+}
+func (c *dockerCompatibility) NetworkList(ctx context.Context, o client.NetworkListOptions) ([]network.Summary, error) {
+	r, e := c.Client.NetworkList(ctx, o)
+	return r.Items, e
+}
+func (c *dockerCompatibility) NetworkRemove(ctx context.Context, id string) error {
+	_, e := c.Client.NetworkRemove(ctx, id, client.NetworkRemoveOptions{})
+	return e
+}
+func (c *dockerCompatibility) VolumeList(ctx context.Context, o client.VolumeListOptions) (volume.ListResponse, error) {
+	r, e := c.Client.VolumeList(ctx, o)
+	return volume.ListResponse{Volumes: r.Items, Warnings: r.Warnings}, e
+}
+func (c *dockerCompatibility) VolumeRemove(ctx context.Context, id string, force bool) error {
+	_, e := c.Client.VolumeRemove(ctx, id, client.VolumeRemoveOptions{Force: force})
+	return e
+}
+func (c *dockerCompatibility) Ping(ctx context.Context) (client.PingResult, error) {
+	return c.Client.Ping(ctx, client.PingOptions{NegotiateAPIVersion: true})
+}
+func (c *dockerCompatibility) NegotiateAPIVersion(ctx context.Context) { _, _ = c.Ping(ctx) }
