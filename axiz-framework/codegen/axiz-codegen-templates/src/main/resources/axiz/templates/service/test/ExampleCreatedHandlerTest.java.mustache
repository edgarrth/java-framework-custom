package {{project.basePackage}}.handler;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatCode;

import java.nio.charset.StandardCharsets;
import java.time.Instant;
import java.util.Map;
import org.junit.jupiter.api.Test;
import pe.axiz.core.messaging.EventEnvelope;
import {{project.basePackage}}.event.ExampleCreated;

class ExampleCreatedHandlerTest {

  private final ExampleCreatedHandler handler = new ExampleCreatedHandler();

  @Test
  void declaresTypeAndPayload() {
    assertThat(handler.eventType()).isEqualTo("{{project.groupId}}.example.created.v1");
    assertThat(handler.payloadType()).isEqualTo(ExampleCreated.class);
  }

  @Test
  void handlesTheEvent() {
    EventEnvelope envelope =
        EventEnvelope.builder().id("evt-1").source("urn:axiz:test").type(handler.eventType()).time(Instant.parse("2026-01-01T00:00:00Z")).subject(null).dataContentType("application/json").data("{}".getBytes(StandardCharsets.UTF_8)).extensions(Map.of()).build();
    assertThatCode(() -> handler.handle(new ExampleCreated("1", "first"), envelope))
        .doesNotThrowAnyException();
  }
}
