<?xml version="1.0" encoding="UTF-8"?>
<!-- {{project.title}}: el starter que añaden los servicios. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-spring</artifactId>
    <version>{{axizVersion}}</version>
    <relativePath/>
  </parent>

  <groupId>{{project.groupId}}</groupId>
  <artifactId>{{platform.capabilityArtifact}}-spring-boot-starter</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>{{project.title}} (starter)</name>
  <description>{{project.descriptionXml}}</description>

  <properties>
    <!-- solo dependencias: el jar contiene únicamente el manifiesto, por diseño (sin la advertencia "JAR will be empty") -->
    <maven.jar.forceCreation>true</maven.jar.forceCreation>
    <axiz.module.name>{{platform.springPackage}}.starter</axiz.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>{{project.groupId}}</groupId>
      <artifactId>{{platform.capabilityArtifact}}-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
