<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-technology</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-technology/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-adapter-inbox-r2dbc</artifactId>
  <name>axiz :: adapter :: inbox-r2dbc</name>
  <description>Inbox (idempotent consumer) on Aurora PostgreSQL over R2DBC</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.technology.reactive-native>true</axiz.technology.reactive-native>
    <axiz.api.baseline.artifactId>axiz-core-inbox-r2dbc</axiz.api.baseline.artifactId>

    <axiz.module.name>pe.axiz.adapter.inbox.r2dbc</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>io.projectreactor</groupId><artifactId>reactor-test</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-inbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-kit-r2dbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-store-contract-tests</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
