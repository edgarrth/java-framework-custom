<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-technology</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-technology/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-adapter-idempotency-dynamodb</artifactId>
  <name>axiz :: adapter :: idempotency-dynamodb</name>
  <description>Idempotency store on DynamoDB with TTL</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.api.baseline.artifactId>axiz-core-idempotency-dynamodb</axiz.api.baseline.artifactId>

    <axiz.module.name>pe.axiz.adapter.idempotency.dynamodb</axiz.module.name>
  </properties>

  <dependencies>
    <!-- how the framework builds this adapter's AWS client (endpoint, region, observation): the
         auto-configuration uses it, so it travels with the adapter -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-observability-aws</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-idempotency</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-store-contract-tests</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-commons</artifactId><version>${project.version}</version></dependency>
  </dependencies>
</project>
