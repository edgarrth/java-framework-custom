<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-technology</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-technology/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-adapter-storage-s3</artifactId>
  <name>axiz :: adapter :: storage-s3</name>
  <description>Amazon S3 object storage with SSE-KMS and presigned URLs</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.api.baseline.artifactId>axiz-core-storage-s3</axiz.api.baseline.artifactId>

    <axiz.module.name>pe.axiz.adapter.storage.s3</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    <!-- how the framework builds this adapter's AWS client (endpoint, region, observation): the
         auto-configuration uses it, so it travels with the adapter -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-observability-aws</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
  </dependencies>
</project>
