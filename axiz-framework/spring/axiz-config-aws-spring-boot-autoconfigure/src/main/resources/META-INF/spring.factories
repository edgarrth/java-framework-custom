org.springframework.boot.EnvironmentPostProcessor=\
pe.axiz.spring.config.aws.AxizConfigAwsEnvironmentPostProcessor,\
pe.axiz.spring.config.aws.AxizConfigAwsValidationEnvironmentPostProcessor
