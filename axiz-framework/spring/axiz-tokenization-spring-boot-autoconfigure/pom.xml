<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>pe.axiz</groupId><artifactId>axiz-parent-spring</artifactId><version>${revision}</version>
    <relativePath>../../platform/axiz-parent-spring/pom.xml</relativePath></parent>
  <artifactId>axiz-tokenization-spring-boot-autoconfigure</artifactId>
  <name>axiz :: tokenization :: spring :: boot :: autoconfigure</name>
  <description>Remote tokenization client without vault, card profile or provider SDK</description>
  <properties><axiz.provider.boundaries.skip>true</axiz.provider.boundaries.skip><axiz.module.name>pe.axiz.spring.tokenization</axiz.module.name><axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity></properties>
  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-commons</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-http</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-errors</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-concurrent</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-http-client</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-restclient</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-webclient</artifactId><optional>true</optional></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-test-spring-boot-starter</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-resource-server</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-jose</artifactId><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-tokenization</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-json</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-http-client-spring-boot-autoconfigure</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-foundation-spring-boot-autoconfigure</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-webflux</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-reactor-netty</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><optional>true</optional></dependency>
    <dependency><groupId>io.projectreactor</groupId><artifactId>reactor-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.projectreactor.tools</groupId><artifactId>blockhound</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
    <executions><execution><id>axiz-token-consumer-boundary</id><goals><goal>enforce</goal></goals>
      <configuration><rules><bannedDependencies><searchTransitive>true</searchTransitive>
        <message>The remote token client must not bring vaults, card profiles, crypto providers or storage SDKs</message>
        <excludes>
          <exclude>pe.axiz:axiz-core-tokenization-vault</exclude>
          <exclude>pe.axiz:axiz-core-tokenization-pan</exclude>
          <exclude>pe.axiz:axiz-tokenization-vault-*</exclude>
          <exclude>pe.axiz:axiz-tokenization-pan-*</exclude>
          <exclude>pe.axiz:axiz-adapter-tokenization-*</exclude>
          <exclude>pe.axiz:axiz-crypto-*</exclude>
          <exclude>software.amazon.awssdk:*</exclude>
          <exclude>io.lettuce:*</exclude>
          <exclude>org.apache.kafka:*</exclude>
        </excludes>
      </bannedDependencies></rules></configuration>
    </execution></executions>
  </plugin></plugins></build>
</project>
