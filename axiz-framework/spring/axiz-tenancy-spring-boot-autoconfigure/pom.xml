<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-spring</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-spring/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-tenancy-spring-boot-autoconfigure</artifactId>
  <name>axiz :: spring :: tenancy :: autoconfigure</name>
  <description>Tenant resolution from token or trusted header and propagation to HTTP, messaging and Hibernate (auto-configuration)</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.module.name>pe.axiz.spring.tenancy</axiz.module.name>
  </properties>

  <dependencies>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-context</artifactId><version>${project.version}</version></dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-tenancy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>context-propagation</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-hibernate</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webflux</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
