<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-spring-lib</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-spring-lib/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-r2dbc-spring-boot-starter</artifactId>
  <name>axiz :: spring :: r2dbc :: starter</name>
  <description>Aurora PostgreSQL for reactive services over R2DBC</description>

  <dependencies>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-r2dbc-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
    </dependency>
    <!-- query spans and metrics through Micrometer Observation -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-proxy</artifactId>
    </dependency>
    <!-- migrations only: Flyway runs over JDBC at startup, the service never uses JDBC -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- IAM authentication tokens (axiz.r2dbc.iam.enabled) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>rds</artifactId>
    </dependency>
  </dependencies>
</project>
