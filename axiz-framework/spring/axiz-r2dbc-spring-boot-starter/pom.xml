<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-spring</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-spring/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-r2dbc-spring-boot-starter</artifactId>
  <name>axiz :: spring :: r2dbc :: starter</name>
  <description>Aurora PostgreSQL for reactive services over R2DBC</description>

  <properties>
    <axiz.module.name>pe.axiz.spring.r2dbc.starter</axiz.module.name>
    <!-- Sin clases Java: solo dependencias y metadatos de inicialización nativa con ámbito. -->
    <maven.jar.forceCreation>true</maven.jar.forceCreation>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-r2dbc-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
    </dependency>
    <!-- spans y métricas de consultas mediante Micrometer Observation -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-proxy</artifactId>
    </dependency>
    <!-- solo migraciones: Flyway se ejecuta sobre JDBC al arrancar, el servicio nunca usa JDBC -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
