<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-spring</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/axiz-parent-spring/pom.xml</relativePath>
  </parent>

  <artifactId>axiz-resilience-spring-boot-autoconfigure</artifactId>
  <name>axiz :: spring :: resilience :: autoconfigure</name>
  <description>Resilience4j defaults (circuit breaker, bulkhead) and Spring @Retryable configured by properties (auto-configuration)</description>

  <properties>
    <axiz.errorprone.fqn.severity>ERROR</axiz.errorprone.fqn.severity>

    <axiz.module.name>pe.axiz.spring.resilience</axiz.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-resilience</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-core-errors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-bulkhead</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
