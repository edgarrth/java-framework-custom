{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "America/Lima",
  "schedule": [
    "before 7am on monday"
  ],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "description": "Servicios axiz: las versiones vienen del parent de axiz; solo se actualiza el parent (axiz upgrade aplica sus recetas)",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Imágenes base en propiedades del POM con comentario renovate: el tag y su digest se actualizan juntos",
      "managerFilePatterns": [
        "/(^|/)pom\\.xml$/"
      ],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+) -->\\s*<[^>]+>[^:<]+:(?<currentValue>[^@<]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?</"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Las actualizaciones menores y de parche de plugins de build y librerías de prueba se agrupan",
      "matchDepTypes": [
        "build",
        "test"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build and test dependencies"
    },
    {
      "description": "Las GitHub Actions se agrupan y se fijan por SHA con el comentario de la versión",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Las imágenes de contenedor se fijan por digest y conservan el tag para leerlas",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Una release nueva de los workflows de Axiz se adopta en un solo pull request",
      "matchPackageNames": [
        "edgarrth/java-framework-custom"
      ],
      "groupName": "axiz workflows",
      "versioning": "regex:^axiz-workflows-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "pinDigests": false
    },
    {
      "description": "Las versiones las gestiona el BOM de axiz: no se actualizan una por una",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "!pe.axiz:axiz-parent-service"
      ],
      "enabled": false
    },
    {
      "description": "Versiones nuevas de axiz: un pull request y luego `axiz upgrade` local para las recetas",
      "matchPackageNames": [
        "pe.axiz:axiz-parent-service"
      ],
      "groupName": "axiz",
      "labels": [
        "axiz-upgrade"
      ],
      "prBodyNotes": [
        "Ejecutar `axiz upgrade --to {{newVersion}}` para actualizar los parents de Axiz y aplicar las convenciones vigentes."
      ]
    },
    {
      "description": "Imágenes del ambiente local (compose.yaml)",
      "matchManagers": [
        "docker-compose"
      ],
      "groupName": "local environment images"
    }
  ]
}
