{
  "schema": 1,
  "verdictScript": "jq -e --argjson skippable \"$SKIPPABLE\" 'length > 0 and all(to_entries[];\n  .value.result == \"success\"\n  or (.value.result == \"skipped\" and (.key | IN($skippable[]))))' <<< \"$NEEDS\" >/dev/null\n",
  "workflows": {
    "framework-ci.yaml": {
      "verdict": {
        "job": "framework-pr-check",
        "name": "axiz-framework-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "axiz-workflows-trust": {
          "class": "required",
          "if": null
        },
        "pr": {
          "class": "required",
          "if": "${{ needs.axiz-workflows-trust.result == 'success' && (github.event_name == 'pull_request') }}"
        },
        "parameters": {
          "class": "required",
          "if": null
        },
        "build": {
          "class": "required",
          "if": null
        },
        "api-compat": {
          "class": "required",
          "if": null
        },
        "native-reactive": {
          "class": "required",
          "if": null
        },
        "wrapper": {
          "class": "required",
          "if": null
        },
        "samples": {
          "class": "required",
          "if": null
        }
      }
    },
    "tools-ci.yaml": {
      "verdict": {
        "job": "tools-pr-check",
        "name": "axiz-tools-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "axiz-workflows-trust": {
          "class": "required",
          "if": null
        },
        "parameters": {
          "class": "required",
          "if": null
        },
        "pr": {
          "class": "required",
          "if": "${{ needs.axiz-workflows-trust.result == 'success' && (github.event_name == 'pull_request') }}"
        },
        "cli-native": {
          "class": "skipped-in-pr",
          "if": "${{ needs.axiz-workflows-trust.result == 'success' && (startsWith(github.ref, 'refs/tags/axiz-tools-v') || inputs.native-cli == true) }}",
          "reason": "Native CLI runs only when explicitly requested or on a tools release tag"
        },
        "build": {
          "class": "required",
          "if": "${{ needs.axiz-workflows-trust.result == 'success' && (!cancelled() && needs.parameters.result == 'success' && (needs.cli-native.result == 'success' || (needs.cli-native.result == 'skipped' && !startsWith(github.ref, 'refs/tags/axiz-tools-v') && inputs.native-cli != true))) }}"
        },
        "initializr": {
          "class": "required",
          "if": null
        },
        "pipeline-contracts": {
          "class": "required",
          "if": null
        }
      }
    },
    "demo-ci.yaml": {
      "verdict": {
        "job": "demo-pr-check",
        "name": "axiz-demo-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "axiz-workflows-trust": {
          "class": "required",
          "if": null
        },
        "parameters": {
          "class": "required",
          "if": null
        },
        "pr": {
          "class": "required",
          "if": "${{ needs.axiz-workflows-trust.result == 'success' && (github.event_name == 'pull_request') }}"
        },
        "service": {
          "class": "required",
          "if": null
        },
        "coverage": {
          "class": "required",
          "if": null
        }
      }
    },
    "docs-pr.yaml": {
      "verdict": {
        "job": "docs-pr-check",
        "name": "axiz-docs-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "axiz-workflows-trust": {
          "class": "required",
          "if": null
        },
        "pr": {
          "class": "required",
          "if": null
        }
      }
    },
    "security.yaml": {
      "verdict": {
        "job": "security-pr-check",
        "name": "axiz-security-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "secrets": {
          "class": "required",
          "if": null
        },
        "sast": {
          "class": "required",
          "if": null
        },
        "filesystem": {
          "class": "required",
          "if": null
        },
        "publish-sarif": {
          "class": "non-blocking",
          "if": "${{ always() && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}",
          "reason": "Publishing diagnostics is independent of the blocking secrets, SAST and vulnerability scans"
        },
        "infrastructure-images": {
          "class": "required",
          "if": null
        }
      }
    },
    "docs-docs.yaml": {
      "verdict": {
        "job": "docs-site-pr-check",
        "name": "axiz-docs-site-pr",
        "mode": "aggregate"
      },
      "jobs": {
        "build": {
          "class": "required",
          "if": null
        },
        "publish": {
          "class": "skipped-in-pr",
          "if": "startsWith(github.ref, 'refs/tags/axiz-docs-v')",
          "reason": "Publishing documentation runs only on a docs release tag"
        },
        "prepare": {
          "class": "skipped-in-pr",
          "if": "startsWith(github.ref, 'refs/tags/axiz-docs-v')",
          "reason": "Publishing documentation runs only on a docs release tag"
        },
        "deploy-pages": {
          "class": "skipped-in-pr",
          "if": "startsWith(github.ref, 'refs/tags/axiz-docs-v')",
          "reason": "Publishing documentation runs only on a docs release tag"
        }
      }
    },
    "workflows-ci.yaml": {
      "verdict": {
        "job": "contracts",
        "name": "axiz-workflows-policy",
        "mode": "single"
      },
      "jobs": {}
    }
  },
  "toleratedSteps": [],
  "permissionExceptions": []
}
