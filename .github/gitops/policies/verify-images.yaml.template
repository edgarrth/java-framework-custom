# Política de admisión de Kyverno: en los namespaces de los servicios solo se admiten imágenes de
# GHCR del owner, referenciadas por digest y con la atestación de procedencia SLSA que publica el
# workflow service-build de Axiz (atestaciones de artefactos de GitHub, formato Sigstore bundle).
# Requiere Kyverno 1.13 o posterior. Se reemplaza OWNER.
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: axiz-verify-images
  annotations:
    policies.kyverno.io/title: Imágenes atestiguadas por axiz
    policies.kyverno.io/description: Solo se ejecutan imágenes construidas por el workflow service-build de Axiz.
spec:
  validationFailureAction: Enforce
  webhookTimeoutSeconds: 15
  background: false
  rules:
    - name: provenance-from-axiz-service-build
      match:
        any:
          - resources:
              kinds: [Pod]
              namespaces: [axiz-dev, axiz-qa, axiz-prod]
      verifyImages:
        - type: SigstoreBundle
          imageReferences:
            - "ghcr.io/OWNER/*"
          mutateDigest: false
          verifyDigest: true
          required: true
          attestations:
            - type: https://slsa.dev/provenance/v1
              attestors:
                - entries:
                    - keyless:
                        issuer: https://token.actions.githubusercontent.com
                        subjectRegExp: '^https://github\.com/edgarrth/java-framework-custom/\.github/workflows/service-build\.yaml@.+$'
                        rekor:
                          url: https://rekor.sigstore.dev
    - name: only-ghcr-by-digest
      match:
        any:
          - resources:
              kinds: [Pod]
              namespaces: [axiz-dev, axiz-qa, axiz-prod]
      validate:
        message: Las imágenes deben venir de GHCR del owner y usar un digest de contenido.
        pattern:
          spec:
            containers:
              - image: "ghcr.io/OWNER/*@sha256:*"
