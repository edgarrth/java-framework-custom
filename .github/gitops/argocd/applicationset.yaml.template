# Una Application de Argo CD por cada archivo environments/<ambiente>/<servicio>.yaml del repositorio
# GitOps, escrito por el workflow service-deploy. El chart se fija por versión y la imagen por
# digest; los values de cada ambiente viajan dentro del chart (values-<ambiente>.yaml). Requiere
# fuentes OCI nativas (Argo CD 3.1 o posterior). Se reemplazan OWNER y GITOPS_REPOSITORY.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: axiz-services
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - git:
        repoURL: https://github.com/OWNER/GITOPS_REPOSITORY.git
        revision: main
        files:
          - path: "environments/*/*.yaml"
  template:
    metadata:
      name: "{{ .service }}-{{ .environment }}"
      labels:
        axiz.pe/service: "{{ .service }}"
        axiz.pe/environment: "{{ .environment }}"
    spec:
      project: axiz-services
      source:
        repoURL: "{{ .chart.oci }}"
        targetRevision: "{{ .chart.version }}"
        path: .
        helm:
          releaseName: "{{ .service }}"
          valueFiles:
            - "values-{{ .environment }}.yaml"
          parameters:
            - name: image.repository
              value: "{{ .image.repository }}"
            - name: image.digest
              value: "{{ .image.digest }}"
      destination:
        server: https://kubernetes.default.svc
        namespace: "axiz-{{ .environment }}"
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - ServerSideApply=true
          - PrunePropagationPolicy=foreground
        retry:
          limit: 3
