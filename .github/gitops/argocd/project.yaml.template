# Proyecto de Argo CD de los servicios axiz: fuentes limitadas al repositorio GitOps y a los charts
# de GHCR del owner, destinos limitados a los namespaces de los servicios y sin recursos de clúster.
# Se reemplazan OWNER y GITOPS_REPOSITORY.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: axiz-services
  namespace: argocd
spec:
  description: Microservicios axiz (una Application por servicio y ambiente)
  sourceRepos:
    - https://github.com/OWNER/GITOPS_REPOSITORY.git
    - ghcr.io/OWNER/charts/*
  destinations:
    - server: https://kubernetes.default.svc
      namespace: axiz-dev
    - server: https://kubernetes.default.svc
      namespace: axiz-qa
    - server: https://kubernetes.default.svc
      namespace: axiz-prod
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: ""
      kind: ConfigMap
    - group: ""
      kind: Service
    - group: ""
      kind: ServiceAccount
    - group: apps
      kind: Deployment
    - group: batch
      kind: CronJob
    - group: autoscaling
      kind: HorizontalPodAutoscaler
    - group: policy
      kind: PodDisruptionBudget
    - group: networking.k8s.io
      kind: NetworkPolicy
    # sin Role ni RoleBinding: los charts de servicio nunca otorgan permisos sobre la API de
    # Kubernetes (la configuración se monta como archivos), así que un servicio no puede ampliar su acceso
    - group: external-secrets.io
      kind: ExternalSecret
