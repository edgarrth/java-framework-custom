# Argo CD project of the axiz services: sources limited to the organization's repositories and
# GHCR, destinations limited to the service namespaces, no cluster-scoped resources.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: axiz-services
  namespace: argocd
spec:
  description: axiz microservices (one Application per service and environment)
  sourceRepos:
    - UNCONFIGURED_GIT_REPOSITORIES
    # Generated from the explicit BUILD_DESTINATION configuration; never apply this template.
    - UNCONFIGURED_CHART_REPOSITORIES
  destinations:
    - server: https://kubernetes.default.svc
      namespace: axiz-dev
    - server: https://kubernetes.default.svc
      namespace: axiz-qa
    - server: https://kubernetes.default.svc
      namespace: axiz-prod
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: ""
      kind: ConfigMap
    - group: ""
      kind: Service
    - group: ""
      kind: ServiceAccount
    - group: apps
      kind: Deployment
    - group: batch
      kind: CronJob
    - group: autoscaling
      kind: HorizontalPodAutoscaler
    - group: policy
      kind: PodDisruptionBudget
    - group: networking.k8s.io
      kind: NetworkPolicy
    # no Role/RoleBinding: service charts never grant Kubernetes API permissions (configuration is
    # mounted as files), so a service repository cannot escalate its own access
    - group: external-secrets.io
      kind: ExternalSecret
  roles:
    - name: ci-read
      description: Read-only token used by service-deploy to confirm immutable sources and health
      policies:
        - p, proj:axiz-services:ci-read, applications, get, axiz-services/*, allow
