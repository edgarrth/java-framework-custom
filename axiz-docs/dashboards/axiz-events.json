{
  "uid": "axiz-events",
  "title": "axiz · eventos",
  "description": "Métricas genéricas por evento: cualquier evento de negocio con $event, $channel y $product.",
  "tags": [
    "axiz"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_events_total, env)",
          "refId": "env"
        },
        "definition": "label_values(axiz_events_total, env)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(process_uptime_seconds{env=~\"$env\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(process_uptime_seconds{env=~\"$env\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "event",
        "label": "Evento",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, event)",
          "refId": "event"
        },
        "definition": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, event)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "channel",
        "label": "Canal",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, channel)",
          "refId": "channel"
        },
        "definition": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, channel)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "product",
        "label": "Producto",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, product)",
          "refId": "product"
        },
        "definition": "label_values(axiz_events_total{env=~\"$env\", service=~\"$service\"}, product)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Volumen y resultado",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Eventos por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event) (rate(axiz_events_total{env=~\"$env\", service=~\"$service\", event=~\"$event\", channel=~\"$channel|\", product=~\"$product|\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{event}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Ratio de éxito",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event) (rate(axiz_events_total{env=~\"$env\", service=~\"$service\", event=~\"$event\", channel=~\"$channel|\", product=~\"$product|\", outcome=\"success\"}[$__rate_interval])) / sum by (event) (rate(axiz_events_total{env=~\"$env\", service=~\"$service\", event=~\"$event\", channel=~\"$channel|\", product=~\"$product|\", outcome!=\"\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{event}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Resultado por motivo (última hora)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event, outcome, reason) (increase(axiz_events_total{env=~\"$env\", service=~\"$service\", event=~\"$event\", channel=~\"$channel|\", product=~\"$product|\", outcome!=\"success\"}[1h]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Eventos por canal",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (channel) (rate(axiz_events_total{env=~\"$env\", service=~\"$service\", event=~\"$event\", channel=~\"$channel|\", product=~\"$product|\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{channel}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
