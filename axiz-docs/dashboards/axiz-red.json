          "expr": "sum by (axiz_operation) (rate(axiz_command_seconds_sum{env=~\"$env\", service=~\"$service\"}[$__rate_interval])) / sum by (axiz_operation) (rate(axiz_command_seconds_count{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
