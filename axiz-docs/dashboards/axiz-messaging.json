{
  "uid": "axiz-messaging",
  "title": "axiz: mensajería",
  "description": "Publicación y consumo de eventos: handlers, inbox, outbox, lag de Kafka y sagas.",
  "tags": [
    "axiz"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_events_total, env)",
          "refId": "env"
        },
        "definition": "label_values(axiz_events_total, env)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(process_uptime_seconds{env=~\"$env\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(process_uptime_seconds{env=~\"$env\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "type",
        "label": "Tipo de evento",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(axiz_event_handler_seconds_count{env=~\"$env\", service=~\"$service\"}, axiz_event_type)",
          "refId": "type"
        },
        "definition": "label_values(axiz_event_handler_seconds_count{env=~\"$env\", service=~\"$service\"}, axiz_event_type)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Consumo",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Eventos procesados (error = none: éxito)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (axiz_event_type, error) (rate(axiz_event_handler_seconds_count{env=~\"$env\", service=~\"$service\", axiz_event_type=~\"$type\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{axiz_event_type}} {{error}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Duración media del handler",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (axiz_event_type) (rate(axiz_event_handler_seconds_sum{env=~\"$env\", service=~\"$service\", axiz_event_type=~\"$type\"}[$__rate_interval])) / sum by (axiz_event_type) (rate(axiz_event_handler_seconds_count{env=~\"$env\", service=~\"$service\", axiz_event_type=~\"$type\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{axiz_event_type}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Fallos de handlers (reintento o DLQ)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (axiz_event_type, error) (increase(axiz_event_handler_seconds_count{env=~\"$env\", service=~\"$service\", axiz_event_type=~\"$type\", error!=\"none\"}[1h]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Los fallos transitorios se reintentan con backoff; los permanentes van a la DLQ. La profundidad de las DLQ de SQS está en CloudWatch (ApproximateNumberOfMessagesVisible).",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Lag de consumidores Kafka (máximo por tópico)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service, topic) (kafka_consumer_fetch_manager_records_lag_max{env=~\"$env\", service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{topic}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Publicación y outbox",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Eventos publicados por destino",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (axiz_destination, error) (rate(axiz_event_publish_seconds_count{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{axiz_destination}} {{error}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Outbox pendiente",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service) (axiz_outbox_pending{env=~\"$env\", service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Registros esperando al relay. Debe volver a cero; si crece, el broker o el relay están fallando.",
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Relay del outbox: lotes (error = none: éxito)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service, error) (rate(axiz_outbox_relay_seconds_count{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}} {{error}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Latencia de publicación p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (axiz_destination, le) (rate(axiz_event_publish_seconds_bucket{env=~\"$env\", service=~\"$service\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{axiz_destination}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Sagas",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": [],
      "id": 11
    },
    {
      "type": "barchart",
      "title": "Sagas terminadas por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (saga, status) (increase(axiz_saga_finished_total{env=~\"$env\", service=~\"$service\"}[1h]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 12
    },
    {
      "type": "barchart",
      "title": "Compensaciones por paso",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (saga, step) (increase(axiz_saga_compensations_total{env=~\"$env\", service=~\"$service\"}[1h]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 13
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "axiz",
      "type": "dashboards",
      "tags": [
        "axiz"
      ],
      "asDropdown": true
    }
  ]
}
