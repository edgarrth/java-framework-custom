{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "axiz framework and tools: third-party versions live in axiz-dependencies",
  "extends": ["github>axiz/axiz-workflows//renovate/default"],
  "packageRules": [
    {
      "description": "Spring and AWS trains move together",
      "matchPackageNames": ["org.springframework.boot:**", "org.springframework.cloud:**", "io.awspring.cloud:**"],
      "groupName": "spring"
    },
    {
      "matchPackageNames": ["software.amazon.awssdk:**"],
      "groupName": "aws sdk"
    },
    {
      "description": "Majors need an architecture contract and the demo green",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
