{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axiz/axiz-workflows/schemas/build-manifest-v1.schema.json",
  "title": "Axiz immutable build manifest v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "axiz.build-manifest/v1"
        },
        "kind": {
          "const": "maven-library"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repository",
            "sha"
          ],
          "unevaluatedProperties": false
        },
        "build": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "object",
              "properties": {
                "repository": {
                  "const": "axiz/axiz-workflows"
                },
                "path": {
                  "enum": [
                    ".github/workflows/lib-build.yaml",
                    ".github/workflows/service-build.yaml"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "required": [
                "repository",
                "path",
                "ref",
                "sha"
              ],
              "unevaluatedProperties": false
            },
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "workflow",
            "run_id",
            "run_attempt"
          ],
          "unevaluatedProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "jdk": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "maven_args": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "native": {
              "type": "object",
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "binary": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "platforms": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "linux-x64",
                      "macos-arm64",
                      "windows-x64"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "module",
                "binary",
                "platforms"
              ],
              "unevaluatedProperties": false
