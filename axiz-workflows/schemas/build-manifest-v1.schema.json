                  "path",
                  "sha256"
                ],
                "unevaluatedProperties": false
              }
            },
            "required": [
              "name",
              "result",
              "evidence"
            ],
            "unevaluatedProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sbom": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "unevaluatedProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "unevaluatedProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "maven": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "groupId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
                  },
                  "extension": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9.]+$"
                  },
                  "classifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "groupId",
                  "artifactId",
                  "version",
                  "extension",
                  "path",
                  "sha256"
                ],
                "unevaluatedProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "maven"
          ],
          "unevaluatedProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "axiz_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
            },
            "axiz_build": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "run_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "run_attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "repository",
                "run_id",
                "run_attempt",
                "manifest_sha256"
              ],
              "unevaluatedProperties": false
            }
          },
          "required": [],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "schema",
        "kind",
        "version",
        "source",
        "build",
        "parameters",
        "parameters_sha256",
        "gates",
        "sbom",
        "provenance",
        "artifacts"
      ],
      "unevaluatedProperties": false
    },
