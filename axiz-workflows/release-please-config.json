{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "generic",
          "path": ".github/workflows/native-nightly.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/native.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/pr.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/lib-build.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/lib-deploy.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/service-build.yaml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/service-deploy.yaml"
        },
        {
          "type": "generic",
          "path": "actions/build-inputs/action.yaml"
        },
        {
          "type": "generic",
          "path": "actions/consume-build/action.yaml"
        },
        {
          "type": "generic",
          "path": "gitops/policies/verify-images.yaml"
        },
        {
          "type": "generic",
          "path": "actions/resolve-service-build/action.yaml"
        }
      ]
    }
  }
}
