<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-initializr: web generator and REST API of axiz projects (the CLI's online mode).
  It is itself an axiz service: built on axiz-parent-service and the platform starters.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-service</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <artifactId>axiz-initializr</artifactId>
  <version>2.0.0</version>
  <name>axiz :: tools :: initializr</name>
  <description>Generates axiz services from an OpenAPI contract: web UI and REST API with corporate SSO</description>

  <properties>
    <!-- renovate: datasource=docker depName=eclipse-temurin -->
    <axiz.initializr.base-image>eclipse-temurin:25-jdk-noble</axiz.initializr.base-image>
    <axiz.base-package>pe.axiz.initializr</axiz.base-package>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- platform capabilities (the initializr dogfoods axiz) -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-foundation-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-errors-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-logging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-observability-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-metrics-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-config-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-audit-spring-boot-starter</artifactId>
    </dependency>
    <!-- client secrets mounted by the ExternalSecret become properties (config tree) -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-spring-boot-starter</artifactId>
    </dependency>
    <!-- generation engine and the formatter of generated code -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-codegen</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.googlejavaformat</groupId>
      <artifactId>google-java-format</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFiles>
            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
          </excludeFilterFiles>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <container>
            <!-- google-java-format needs the compiler internals -->
            <jvmFlags combine.children="append">
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</jvmFlag>
              <jvmFlag>--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</jvmFlag>
            </jvmFlags>
          </container>
          <!-- the formatter needs jdk.compiler: full JDK base image instead of the JRE -->
          <from>
            <image>${axiz.initializr.base-image}</image>
          </from>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
