<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Injected collaborator: identity and lifecycle are shared with the application context. -->
  <Match>
    <Class name="pe.axiz.initializr.service.GenerationService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Field name="meters"/>
  </Match>
  <!-- Session authorization boundary is deliberately shared with Spring Security, not copied. -->
  <Match>
    <Class name="pe.axiz.initializr.api.GitHubController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Field name="authorizedClients"/>
  </Match>
</FindBugsFilter>
