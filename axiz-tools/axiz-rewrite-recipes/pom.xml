<?xml version="1.0" encoding="UTF-8"?>
<!--
  Recetas de OpenRewrite que `axiz upgrade` aplica cuando un proyecto pasa a otra versión de axiz:
  rewrite-maven-plugin con -Drewrite.recipeArtifactCoordinates=pe.axiz:axiz-rewrite-recipes:<version>
  -Drewrite.activeRecipes=pe.axiz.UpgradeToAxiz. Solo se distribuyen recetas entre versiones de Axiz 2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-tooling</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <artifactId>axiz-rewrite-recipes</artifactId>
  <version>2.0.0</version>
  <name>axiz :: tools :: rewrite recipes</name>
  <description>Declarative OpenRewrite recipes to upgrade services between axiz versions</description>

  <properties>
    <axiz.module.name>pe.axiz.rewrite</axiz.module.name>
    <rewrite-recipe-bom.version>3.20.0</rewrite-recipe-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- error_prone_annotations y org.jetbrains:annotations, que los módulos de OpenRewrite
           solicitan en versiones distintas, los gestiona axiz-dependencies -->
      <dependency>
        <groupId>org.openrewrite.recipe</groupId>
        <artifactId>rewrite-recipe-bom</artifactId>
        <version>${rewrite-recipe-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>




    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-xml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>



    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-properties</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- recetas referenciadas por las declarativas; las resuelve rewrite-maven-plugin con este artefacto -->
    <dependency>
      <groupId>org.openrewrite.recipe</groupId>
      <artifactId>rewrite-spring</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <!-- rewrite-jackson solicita el milestone 4.0.0-M1 de AssertJ: la plataforma solo incluye
             releases, así que el jar que sus recetas buscan en el classpath es la release gestionada
             (declarada más abajo) -->
        <exclusion>
          <groupId>org.assertj</groupId>
          <artifactId>assertj-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openrewrite.recipe</groupId>
      <artifactId>rewrite-migrate-java</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>axiz-dependency-convergence</id>
            <configuration>
              <rules>
                <banDuplicateClasses combine.self="override">
                  <findAllDuplicates>true</findAllDuplicates>
                  <ignoreWhenIdentical>true</ignoreWhenIdentical>
                  <scopes>
                    <scope>compile</scope>
                    <scope>runtime</scope>
                  </scopes>
                  <ignoreClasses>
                    <ignoreClass>module-info</ignoreClass>
                    <ignoreClass>META-INF.versions.*</ignoreClass>
                  </ignoreClasses>
                  <dependencies>
                    <!-- Los parsers por versión de Java de OpenRewrite incluyen el package-info de los
                         paquetes que comparten con rewrite-java (org.openrewrite.java) y entre sí
                         (org.openrewrite.java.isolated). Un package-info solo contiene anotaciones de
                         paquete (nulabilidad por defecto), sin código: solo esas dos entradas se
                         ignoran, y toda otra clase de estos jars se sigue verificando. -->
                    <dependency>
                      <groupId>org.openrewrite</groupId>
                      <artifactId>rewrite-java-8</artifactId>
                      <ignoreClasses>
                        <ignoreClass>org.openrewrite.java.package-info</ignoreClass>
                      </ignoreClasses>
                    </dependency>
                    <dependency>
                      <groupId>org.openrewrite</groupId>
                      <artifactId>rewrite-java-21</artifactId>
                      <ignoreClasses>
                        <ignoreClass>org.openrewrite.java.isolated.package-info</ignoreClass>
                      </ignoreClasses>
                    </dependency>
                    <dependency>
                      <groupId>org.openrewrite</groupId>
                      <artifactId>rewrite-java-25</artifactId>
                      <ignoreClasses>
                        <ignoreClass>org.openrewrite.java.isolated.package-info</ignoreClass>
                      </ignoreClasses>
                    </dependency>
                  </dependencies>
                </banDuplicateClasses>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
