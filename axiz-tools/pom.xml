<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-tools: herramientas de desarrollo de la plataforma axiz.
    axiz-cli              CLI con picocli (binario nativo): new, add, generate, contract, upgrade, doctor, local
    axiz-initializr       generador web y API REST (SSO), el modo online de la CLI
    axiz-rewrite-recipes  recetas de OpenRewrite que aplica `axiz upgrade`
  Todas usan el motor de generación del framework (pe.axiz:axiz-codegen).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.axiz</groupId>
  <artifactId>axiz-tools</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>axiz :: tools</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- El agregador no se despliega, pero debe inventariar las herramientas publicadas y el Initializr. -->
    <cyclonedx.skipNotDeployed>false</cyclonedx.skipNotDeployed>
  </properties>

  <modules>
    <module>axiz-rewrite-recipes</module>
    <module>axiz-cli</module>
    <module>axiz-initializr</module>
  </modules>
</project>
