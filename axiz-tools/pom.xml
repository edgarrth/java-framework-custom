<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz-tools: developer tooling of the axiz platform.
    axiz-cli              picocli CLI (native binary): new, add, generate, contract, upgrade, doctor, local
    axiz-initializr       web generator and REST API (SSO), the CLI's online mode
    axiz-rewrite-recipes  OpenRewrite recipes applied by `axiz upgrade`
  All of them use the generation engine of the framework (pe.axiz:axiz-codegen).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.axiz</groupId>
  <artifactId>axiz-tools</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>axiz :: tools</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>axiz-rewrite-recipes</module>
    <module>axiz-cli</module>
    <module>axiz-initializr</module>
  </modules>
</project>
