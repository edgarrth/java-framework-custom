{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "America/Lima",
  "schedule": [
    "before 7am on monday"
  ],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "description": "Monorepo de Axiz: framework, herramientas, documentación y workflows",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Imágenes base en propiedades del POM con comentario renovate: el tag y su digest se actualizan juntos",
      "managerFilePatterns": [
        "/(^|/)pom\\.xml$/"
      ],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+) -->\\s*<[^>]+>[^:<]+:(?<currentValue>[^@<]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?</"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Las actualizaciones menores y de parche de plugins de build y librerías de prueba se agrupan",
      "matchDepTypes": [
        "build",
        "test"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build and test dependencies"
    },
    {
      "description": "Las GitHub Actions se agrupan y se fijan por SHA con el comentario de la versión",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Las imágenes de contenedor se fijan por digest y conservan el tag para leerlas",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Los trenes de Spring y AWS avanzan juntos",
      "matchPackageNames": [
        "org.springframework.boot:**",
        "org.springframework.cloud:**",
        "io.awspring.cloud:**"
      ],
      "groupName": "spring"
    },
    {
      "matchPackageNames": [
        "software.amazon.awssdk:**"
      ],
      "groupName": "aws sdk"
    },
    {
      "description": "Las versiones mayores requieren revisar compatibilidad y pasar las pruebas de integración",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "release-please es dueño de las referencias del producto a sí mismo",
      "matchPackageNames": [
        "edgarrth/java-framework-custom"
      ],
      "enabled": false
    }
  ]
}
