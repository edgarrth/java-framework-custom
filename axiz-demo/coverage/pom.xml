<?xml version="1.0" encoding="UTF-8"?>
<!-- Checks that the demo uses every capability of the axiz catalog (see src/test/resources/coverage.yaml). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-core</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>axiz-demo-coverage</artifactId>
  <version>2.0.0</version>
  <name>axiz demo: capability coverage</name>

  <properties>
    <axiz.module.name>pe.axiz.payments.demo.coverage</axiz.module.name>
    <!-- tests only: the jar holds just the manifest, by design (no "JAR will be empty" warning) -->
    <maven.jar.forceCreation>true</maven.jar.forceCreation>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- the tests are the only code of this module: SpotBugs analyzes them (with no production
         classes it would find nothing to analyze and only warn) -->
    <spotbugs.includeTests>true</spotbugs.includeTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-archetypes</artifactId>
      <version>${project.parent.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
