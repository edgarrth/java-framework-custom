meta {
  name: My beneficiaries (masked)
  type: http
  seq: 8
}

get {
  url: {{experience}}/v1/beneficiaries?size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 200", function () { expect(res.status).to.equal(200); });
  test("masked", function () { res.body.items.forEach(b => expect(b.creditorCci).to.match(/^\*+\d{4}$/)); });
}
