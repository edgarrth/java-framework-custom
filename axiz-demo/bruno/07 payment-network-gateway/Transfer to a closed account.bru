meta {
  name: Transfer to a closed account
  type: http
  seq: 20
}

post {
  url: {{gateway}}/v1/transfers
  body: json
  auth: bearer
}

script:pre-request {
  // a new key per run; repeat the request with the same key to see the stored response replayed
  req.setHeader("Idempotency-Key", `bruno-${Date.now()}-${Math.random().toString(16).slice(2)}`);
}

auth:bearer {
  token: {{m2mToken}}
}

body:json {
  {
    "creditorCci": "00219100123456780052",
    "amount": 5,
    "currency": "PEN",
    "reference": "BRUNO-4"
  }
}

tests {
  test("status 422", function () { expect(res.status).to.equal(422); });
  test("code PAYMENTS-BANKINGCORE-0003", function () { expect(res.body.code).to.equal("PAYMENTS-BANKINGCORE-0003"); });
}
