meta {
  name: Customer token (ana)
  type: http
  seq: 1
}

post {
  url: {{keycloak}}/realms/axiz/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: payments-web
  username: {{username}}
  password: {{password}}
}

script:post-response {
  bru.setVar("token", res.body.access_token);
}

tests {
  test("status 200", function () { expect(res.status).to.equal(200); });
}
