meta {
  name: Debit without funds
  type: http
  seq: 18
}

post {
  url: {{core}}/v1/debits
  body: json
  auth: bearer
}

script:pre-request {
  // a new key per run; repeat the request with the same key to see the stored response replayed
  req.setHeader("Idempotency-Key", `bruno-${Date.now()}-${Math.random().toString(16).slice(2)}`);
}

auth:bearer {
  token: {{m2mToken}}
}

body:json {
  {
    "accountId": "1910099999999",
    "amount": 10.5,
    "currency": "PEN",
    "reference": "BRUNO-2"
  }
}

tests {
  test("status 422", function () { expect(res.status).to.equal(422); });
  test("code PAYMENTS-COREINTEGRATION-0001", function () { expect(res.body.code).to.equal("PAYMENTS-COREINTEGRATION-0001"); });
}
