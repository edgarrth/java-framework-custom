meta {
  name: Debit
  type: http
  seq: 16
}

post {
  url: {{core}}/v1/debits
  body: json
  auth: bearer
}

script:pre-request {
  // a new key per run; repeat the request with the same key to see the stored response replayed
  req.setHeader("Idempotency-Key", `bruno-${Date.now()}-${Math.random().toString(16).slice(2)}`);
}

auth:bearer {
  token: {{m2mToken}}
}

body:json {
  {
    "accountId": "{{debtorAccount}}",
    "amount": 10.5,
    "currency": "PEN",
    "holderId": "{{customerId}}",
    "reference": "BRUNO-1"
  }
}

script:post-response {
  bru.setVar("movementId", res.body.movementId);
}

tests {
  test("status 201", function () { expect(res.status).to.equal(201); });
}
