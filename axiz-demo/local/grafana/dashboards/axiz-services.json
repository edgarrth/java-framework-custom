{
 "uid": "axiz-services",
 "title": "axiz: services (RED)",
 "description": "Rate, errors and duration of every axiz service, outbound clients and resilience state.",
 "tags": [
  "axiz"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(target_info, job)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by service",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate({__name__=~\"http_server_requests(_milliseconds|_seconds)?_count\",job=~\"$service\"}[5m]))",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error ratio (5xx)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate({__name__=~\"http_server_requests(_milliseconds|_seconds)?_count\",job=~\"$service\",status=~\"5..\"}[5m])) / sum by (job) (rate({__name__=~\"http_server_requests(_milliseconds|_seconds)?_count\",job=~\"$service\"}[5m]))",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95 by service",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\"http_server_requests(_milliseconds|_seconds)?_bucket\",job=~\"$service\"}[5m])))",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Outbound calls by client (http.client name)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, client_name) (rate({__name__=~\"http_client_requests(_milliseconds|_seconds)?_count\",job=~\"$service\"}[5m]))",
     "legendFormat": "{{job}} \u2192 {{client_name}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Circuit breakers open",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, name) (resilience4j_circuitbreaker_state{state=\"open\",job=~\"$service\"})",
     "legendFormat": "{{job}} {{name}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "JVM heap used",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\",job=~\"$service\"})",
     "legendFormat": "{{job}}"
    }
   ]
  }
 ]
}