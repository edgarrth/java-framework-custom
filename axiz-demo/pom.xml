<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz demo: payment processor built with the axiz framework. Aggregator only: every service is an
  independent project (own pipeline, chart and release); this POM lets `./mvnw verify` build them
  all at once and runs the capability coverage check.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>axiz-demo</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>axiz demo: payments</name>

  <modules>
    <module>services/payments-experience</module>
    <module>services/payments-business</module>
    <module>services/beneficiaries-crud</module>
    <module>services/core-integration</module>
    <module>services/payment-process</module>
    <module>services/payments-history</module>
    <module>services/notifications-processor</module>
    <module>services/settlement-batch</module>
    <module>coverage</module>
  </modules>
</project>
