<?xml version="1.0" encoding="UTF-8"?>
<!--
  axiz demo: procesador de pagos construido con el framework axiz. Solo agregador: cada servicio es un
  proyecto independiente (pipeline, chart y release propios); este POM permite que `./mvnw verify` los construya
  todos a la vez y ejecuta la verificación de cobertura de capacidades.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>axiz-demo</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>axiz demo: payments</name>

  <modules>
    <module>services/payments-ux</module>
    <module>services/payment-orders</module>
    <module>services/beneficiaries</module>
    <module>services/banking-core</module>
    <module>services/payment-process</module>
    <module>services/payments-history</module>
    <module>services/notifications-processor</module>
    <module>services/settlement-batch</module>
    <module>services/payment-network-gateway</module>
    <module>examples/protected-data</module>
    <module>examples/provider-recipes</module>
    <module>examples/sqs-consumer</module>
    <module>coverage</module>
  </modules>
</project>
