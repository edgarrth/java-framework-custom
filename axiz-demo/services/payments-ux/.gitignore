# Maven configuration is source, even when a developer globally ignores .mvn.
!.mvn/
!.mvn/jvm.config
!.mvn/maven.config
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties

target/
.mvn/wrapper/maven-wrapper.jar
*.class
*.log
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.DS_Store
# local secrets never go to the repository
local/secrets/
.env
*.pem
*.key
