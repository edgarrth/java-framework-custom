<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payments UX: Payments API for the channels
  Generado por axiz (ux / bff / reactive). Las versiones de las dependencias provienen del BOM de axiz.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-service</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>payments-ux</artifactId>
  <version>2.0.0</version>
  <name>Payments UX</name>
  <description>Payments API for the channels</description>

  <properties>
    <axiz.base-package>pe.axiz.payments.ux</axiz.base-package>
    <axiz.openapi.model-package>${axiz.base-package}.composition.model</axiz.openapi.model-package>
  </properties>

  <dependencies>
    <!-- Los eventos estándar de ejecución de JUnit conservan la evidencia de capacidades de TestReporter. -->
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-reporting</artifactId><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-config-aws-spring-boot-starter</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-context</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-api</artifactId><version>${project.version}</version></dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- Soporte de WebClient de Spring Boot (builder, codecs, observación) para los clientes HTTP: en
         Boot 4 es un módulo propio, no forma parte del starter de WebFlux -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webclient</artifactId>
    </dependency>
    <!-- capacidades de axiz -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-foundation-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-web-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-errors-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-logging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-observability-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-metrics-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-config-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-i18n-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-sensitive-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-security-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-resilience-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-http-client-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-cache-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-idempotency-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-featureflags-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-structure-bff-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-idempotency-redis-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-cache-redis-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-security-redis-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- pruebas (axiz-test-spring-boot-starter y las reglas de ArchUnit provienen del parent) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- las llamadas bloqueantes en hilos del event loop hacen fallar las pruebas (BlockHoundExtension) -->
    <dependency>
      <groupId>io.projectreactor.tools</groupId>
      <artifactId>blockhound</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Eventos del launcher separados: Failsafe nunca debe sobrescribir la evidencia de capacidades de Surefire. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/surefire-reports
        </configurationParameters></properties></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/failsafe-reports
        </configurationParameters></properties></configuration>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFiles>
            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
          </excludeFilterFiles>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
