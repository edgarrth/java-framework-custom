<?xml version="1.0" encoding="UTF-8"?>
<!--
  Settlement Batch: Daily settlement and reconciliation
  Generado por axiz (batch / batch / servlet). Las versiones de las dependencias provienen del BOM de axiz.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-service</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>settlement-batch</artifactId>
  <version>2.0.0</version>
  <name>Settlement Batch</name>
  <description>Daily settlement and reconciliation</description>

  <properties>
    <axiz.base-package>pe.axiz.payments.settlement</axiz.base-package>
    <axiz.openapi.model-package>${axiz.base-package}.job.model</axiz.openapi.model-package>
  </properties>

  <dependencies>
    <!-- Los eventos estándar de ejecución de JUnit conservan la evidencia de capacidades de TestReporter. -->
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-reporting</artifactId><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-jpa-aws-spring-boot-starter</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-config-aws-spring-boot-starter</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-json</artifactId><version>${project.version}</version></dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch-jdbc</artifactId>
    </dependency>
    <!-- capacidades de axiz -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-foundation-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-errors-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-logging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-observability-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-metrics-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-config-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-storage-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-audit-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-file-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-jpa-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-scheduling-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-structure-batch-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-storage-s3-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId><artifactId>axiz-scheduling-jdbc-spring-boot-starter</artifactId>
    </dependency>

    <!-- pruebas (axiz-test-spring-boot-starter y las reglas de ArchUnit provienen del parent) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Eventos del launcher separados: Failsafe nunca debe sobrescribir la evidencia de capacidades de Surefire. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/surefire-reports
        </configurationParameters></properties></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/failsafe-reports
        </configurationParameters></properties></configuration>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFiles>
            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
          </excludeFilterFiles>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
