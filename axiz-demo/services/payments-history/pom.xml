<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payments History: Payment history of each customer: read model projected from the payment order events over R2DBC
  Generated by axiz (business / cqrs / reactive). Dependency versions come from the axiz BOM.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-service</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>payments-history</artifactId>
  <version>2.0.0</version>
  <name>Payments History</name>
  <description>Payment history of each customer: read model projected from the payment order events over R2DBC</description>

  <properties>
    <axiz.base-package>pe.axiz.payments.history</axiz.base-package>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- axiz capabilities -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-foundation-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-web-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-errors-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-logging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-observability-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-metrics-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-config-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-i18n-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-sensitive-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-security-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-audit-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-r2dbc-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-inbox-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-messaging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-crypto-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-extension-cqrs-spring-boot-starter</artifactId>
    </dependency>
    <!-- ReactiveTypedEventHandler: non-blocking Kafka consumers that feed the reactive command bus -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-inbox-r2dbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-messaging-kafka</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.msk</groupId>
      <artifactId>aws-msk-iam-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-secrets-aws</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>ssm</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-crypto-kms</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
    </dependency>

    <!-- tests (axiz-test-spring-boot-starter and the ArchUnit rules come from the parent) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- blocking calls on event-loop threads fail the tests (BlockHoundExtension) -->
    <dependency>
      <groupId>io.projectreactor.tools</groupId>
      <artifactId>blockhound</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
