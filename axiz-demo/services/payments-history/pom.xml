<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payments History: Payment history of each customer: read model projected from the payment order events over R2DBC
  Generado por axiz (business / cqrs / reactive). Las versiones de las dependencias provienen del BOM de axiz.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pe.axiz</groupId>
    <artifactId>axiz-parent-service</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>pe.axiz.payments</groupId>
  <artifactId>payments-history</artifactId>
  <version>2.0.0</version>
  <name>Payments History</name>
  <description>Payment history of each customer: read model projected from the payment order events over R2DBC</description>

  <properties>
    <axiz.base-package>pe.axiz.payments.history</axiz.base-package>
    <axiz.openapi.model-package>${axiz.base-package}.adapter.in.rest.model</axiz.openapi.model-package>
  </properties>

  <dependencies>
    <!-- Los eventos estándar de ejecución de JUnit conservan la evidencia de capacidades de TestReporter. -->
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-reporting</artifactId><scope>test</scope></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-config-aws-spring-boot-starter</artifactId><version>${project.version}</version></dependency>

<dependency><groupId>pe.axiz</groupId><artifactId>axiz-messaging-msk-spring-boot-starter</artifactId></dependency>
    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-core-api</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>pe.axiz</groupId><artifactId>axiz-r2dbc-aws-spring-boot-starter</artifactId><scope>runtime</scope></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- capacidades de axiz -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-foundation-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-web-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-errors-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-logging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-observability-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-metrics-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-config-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-i18n-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-sensitive-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-security-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-audit-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-r2dbc-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-inbox-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-messaging-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-file-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-crypto-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-extension-cqrs-spring-boot-starter</artifactId>
    </dependency>
    <!-- ReactiveTypedEventHandler: consumidores de Kafka no bloqueantes que alimentan el bus de comandos reactivo -->
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-inbox-r2dbc-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-messaging-kafka-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-secrets-aws-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>ssm</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-crypto-kms-spring-boot-starter</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
    </dependency>

    <!-- pruebas (axiz-test-spring-boot-starter y las reglas de ArchUnit provienen del parent) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- las llamadas bloqueantes en hilos del event loop hacen fallar las pruebas (BlockHoundExtension) -->
    <dependency>
      <groupId>io.projectreactor.tools</groupId>
      <artifactId>blockhound</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build><plugins>
      <!-- Eventos del launcher separados: Failsafe nunca debe sobrescribir la evidencia de capacidades de Surefire. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/surefire-reports
        </configurationParameters></properties></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
        <configuration><properties><configurationParameters>
          junit.platform.reporting.output.dir = ${project.build.directory}/failsafe-reports
        </configurationParameters></properties></configuration>
      </plugin>
  </plugins></build>
</project>
