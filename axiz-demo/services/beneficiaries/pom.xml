    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-idempotency-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-structure-layered-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>pe.axiz</groupId>
      <artifactId>axiz-adapter-idempotency-dynamodb</artifactId>
