<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Injected collaborator: identity and lifecycle are shared with the application context. -->
  <Match>
    <Class name="pe.axiz.payments.orders.adapter.out.messaging.PaymentEventsOutboxAdapter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Field name="events"/>
  </Match>
  <!-- Spring injects a transaction-scoped EntityManager proxy. It must retain identity;
       copying it would lose the current persistence context. The field is never exposed. -->
  <Match>
    <Class name="pe.axiz.payments.orders.adapter.out.persistence.PaymentOrderPersistenceAdapter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Field name="entityManager"/>
  </Match>
</FindBugsFilter>
